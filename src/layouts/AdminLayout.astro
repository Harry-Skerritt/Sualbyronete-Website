---
// src/layouts/AdminLayout.astro
import "../styles/global.css";
import AdminHeader from "../components/admin/AdminHeader.astro";
import Footer from "../components/Footer.astro";
import Toast from "../components/admin/Toast.astro";
import {ADMIN_SITE_NAME, SITE_NAME} from "../config/siteSettings";

const baseURL = import.meta.env.BASE_URL;

interface Props {
    title?: string;
    showHeader?: boolean;
    showFooter?: boolean;
}

const { title = `${SITE_NAME} | ${ADMIN_SITE_NAME}`, showHeader = true, showFooter = true } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href=`${baseURL}favicon.svg` />
    <link rel="icon" href=`${baseURL}favicon.ico` />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
</head>
<body>

    { showHeader && <AdminHeader /> }
    <Toast />
    <slot />
    { showFooter && <Footer /> }


</body>
</html>
