---
// src/components/TabbedFilter.astro

import { Icon } from 'astro-icon/components'

interface Props {
    option_one: string;
    option_one_icon: string;
    option_one_value: string;
    option_two: string;
    option_two_icon: string;
    option_two_value: string;
    default_selected: number;
    custom_event_name: string;
    class?: string;
}

const {
    option_one,
    option_one_icon,
    option_one_value,
    option_two,
    option_two_icon,
    option_two_value,
    default_selected,
    custom_event_name,
    class: className
} = Astro.props;
---

<div
        class={`filter-body ${className || ''}`}
        data-filter-bar
        data-active-tab={default_selected === 1 ? "one" : "two"}
        data-custom-event={custom_event_name}
        data-active-value={default_selected === 1 ? option_one_value : option_two_value}
>

    <div class="sliding-indicator"></div>

    <div class="filter-option" data-target={option_one_value} data-tab-index="one">
        <Icon class="option-icon" name={option_one_icon}/>
        <h1>{option_one}</h1>
    </div>

    <div class="filter-option" data-target={option_two_value} data-tab-index="two">
        <Icon class="option-icon" name={option_two_icon}/>
        <h1>{option_two}</h1>
    </div>

</div>

<style lang="scss">
    .filter-body {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: row;
        height: 3.5rem;
        justify-content: space-between;
        gap: 0.8rem;
        background-color: transparent;
        border-radius: 0.8rem;
        isolation: isolate;
    }

    .filter-option {
        flex: 1;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        border-radius: 0.8rem;
        color: var(--colour-dark);
        cursor: pointer;
        z-index: 2;
        transition: color 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        padding: 0 0.5rem;
    }

    .filter-option h1 {
        font-size: 1.5rem;
        margin: 0;
    }

    .option-icon {
        width: 2.5rem;
        height: 2.5rem;
        flex-shrink: 0;
    }

    /* --- SLIDING INDICATOR PILL --- */
    .sliding-indicator {
        position: absolute;
        top: 0;
        left: 0;
        width: calc(50% - 0.4rem);
        height: 100%;
        background-color: var(--colour-dark);
        border-radius: 0.8rem;
        z-index: 1;
        transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
        pointer-events: none;
    }


    /* State 1 */
    [data-active-tab="one"] .sliding-indicator {
        transform: translateX(0);
    }

    /* State 2 */
    [data-active-tab="two"] .sliding-indicator {
        transform: translateX(calc(100% + 0.8rem));
    }

    [data-active-tab="one"] [data-tab-index="one"],
    [data-active-tab="two"] [data-tab-index="two"] {
        color: var(--colour-light);
    }

    /* Mobile Styling */
    @media (#{$mobile}) {
        .filter-body {
            height: 3rem;
            gap: 0.5rem;
        }

        .filter-option {
            gap: 0.5rem;
        }

        .filter-option h1 {
            font-size: 1.05rem;
        }

        .option-icon {
            width: 1.6rem;
            height: 1.6rem;
        }

        .sliding-indicator {
            width: calc(50% - 0.25rem);
        }

        [data-active-tab="two"] .sliding-indicator {
            transform: translateX(calc(100% + 0.5rem));
        }
    }
</style>

<script>
    function initSlidingFilters() {
        const filterBars = document.querySelectorAll('[data-filter-bar]');

        filterBars.forEach(bar => {
            const options = bar.querySelectorAll('.filter-option');
            const eventName = bar.getAttribute('data-custom-event') || 'breedChange';

            options.forEach(option => {
                option.addEventListener('click', () => {
                    const tabIndex = option.getAttribute('data-tab-index');
                    const targetState = option.getAttribute('data-target');
                    if (!tabIndex || !targetState) return;

                    bar.setAttribute('data-active-tab', tabIndex);
                    bar.setAttribute('data-active-value', targetState);

                    const event = new CustomEvent(eventName, {
                        detail: { value: targetState }
                    });
                    window.dispatchEvent(event);
                });
            });
        });
    }

    initSlidingFilters();
    document.addEventListener('astro:page-load', initSlidingFilters);
</script>