---
// src/components/Header.astro

import '../styles/global.css'
import { Icon } from 'astro-icon/components'

const { pathname } = Astro.url;

const links = [
    { name: 'Home', href: '/' },
    { name: 'Puppies', href: '/puppies' },
    { name: 'Adults', href: '/adults' },
    { name: 'Contact', href: '/contact'}
];

const isActive = (href: string) => {
    const normalise = (path: string) => path.replace(/\/$/, "");
    return normalise(pathname) === normalise(href);
}
---

<header id="main-header" class="header-initial">
    <div class="header-container">
        <!-- Logo and Name -->
        <div class="left-group">
            <img src="/logo-basic/Logo-Basic.png" alt="basic-logo" class="logo"/>
            <div class="vert-separator"></div>
            <h1 class="header-text">Sualbyronete</h1>
        </div>

        <!-- Navigation -->
        <nav class="nav-links">
            {links.map((link, index) => (
                <li class="nav-item">
                    <a href={link.href} class={isActive(link.href) ? "active" : ""}>
                        {link.name}
                    </a>
                    {index < links.length - 1 && <Icon name="paw-print" class="nav-divider"/>}
                </li>
            ))}
        </nav>

    </div>
</header>

<style>

    .header-initial {
        position: sticky;
        top: 0;
        z-index: 100;

        height: var(--header-height);
        background-color: var(--colour-primary);
        border-radius: 0 0 0px 0px;
        transition: border-radius 0.3s ease, box-shadow 0.3s ease;

        box-shadow: 0px 7px 7px 0px rgba(0,0,0,0.25);
        display: flex;
        justify-content: center;

    }

    .header-initial.scrolled {
        border-radius: 0 0 20px 20px;
    }

    .header-container
    {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        height: 100%;
        width: 95%;
        padding: 0 2rem;
    }

    .left-group
    {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .logo {
        height: var(--header-height);
    }

    .vert-separator
    {
        height: 80%;
        background-color: var(--colour-dark);
        width: 2px;
        border-radius: 999px 999px 999px 999px;
        margin-left: 1rem;
        margin-right: 1.2rem;
    }

    .header-text {
        font-family: var(--font-primary);
        font-weight: 700;
        font-size: 2.5rem;
        color: var(--colour-dark);
        padding: 0;
        margin: 0;
        height: 100%;
        align-content: center;
    }

    .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .nav-item {
        display: flex;
        align-items: center;
    }

    .nav-item a {
        font-family: var(--font-primary);
        text-decoration: none;
        color: var(--colour-white);
        font-weight: bold;
        font-size: 2.1rem;
        padding-left: 1.1rem;
        padding-right: 1.1rem;
        transition: color 0.2s;
    }

    .nav-item a:hover {
        color: var(--colour-dark);
    }

    .nav-item a.active {
        color: var(--colour-dark);
    }

    .nav-divider {
        height: 2rem;
        width: auto;
        color: var(--colour-white);
    }

</style>

<script>
    function initHeaderScroll() {
        const header = document.getElementById('main-header');
        if (!header) return;

        const snapContainer = document.querySelector('.snap-scroll-container');

        const checkScroll = (scrollTarget: Window | Element) => {
            // Adds class if window is scrolled down past 0 pixels
            const scrollTop = scrollTarget instanceof Window
                ? window.scrollY
                : scrollTarget.scrollTop;

            if (scrollTop > 0) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }

            if (snapContainer) {
                // INDEX PAGE: Listen to the internal container scrolling
                checkScroll(snapContainer);
                snapContainer.addEventListener('scroll', () => checkScroll(snapContainer), { passive: true });
            } else {
                // OTHER PAGES: Fall back to default window scrolling
                checkScroll(window);
                window.addEventListener('scroll', () => checkScroll(window), { passive: true });
            }
        };
    }

    initHeaderScroll();
    document.addEventListener('astro:page-load', initHeaderScroll);
</script>