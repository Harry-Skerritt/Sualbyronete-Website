---
// src/components/Header.astro

import '../styles/global.css'
import { Icon } from 'astro-icon/components'

const { pathname } = Astro.url;
const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
    { name: 'Home', href: baseURL === "" ? "/" : baseURL },
    { name: 'Puppies', href: `${baseURL}/puppies` },
    { name: 'Adults', href: `${baseURL}/adults` },
    { name: 'Contact', href: `${baseURL}/contact`}
];

const isActive = (href: string) => {
    const normalise = (path: string) => path.replace(/\/$/, "").toLowerCase();
    const currentPath = normalise(pathname);
    const linkPath = normalise(href);

    if (linkPath == normalise(baseURL) || linkPath === "") {
        return currentPath === linkPath || currentPath === "";
    }

    return currentPath === linkPath || currentPath.startsWith(linkPath + '/');
}
---

<header id="main-header" class="header-initial">
    <div class="header-container">
        <!-- Logo and Name -->
        <a href={`${baseURL === "" ? "/" : baseURL}`} class="left-group">
            <img src={`${baseURL}/logo-basic/Logo-Basic.png`} alt="basic-logo" class="logo"/>
            <div class="vert-separator"></div>
            <h1 class="header-text">Sualbyronete</h1>
        </a>

        <!-- Mobile Hamburger Menu -->
        <button id="menu-toggle" class="hamburger-btn" aria-label="Toggle Menu" aria-expanded="false">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>

        <!-- Navigation -->
        <nav class="nav-menu" id="nav-menu">
            <ul class="nav-links">
                {links.map((link, index) => (
                        <li class="nav-item">
                            <!-- Mobile Bullet -->
                            <Icon name="paw-print" class="nav-bullet" />

                            <a href={link.href} class={isActive(link.href) ? "active" : ""}>
                                {link.name}
                            </a>

                            <!-- Desktop Divider -->
                            {index < links.length - 1 && <Icon name="paw-print" class="nav-divider"/>}
                        </li>
                ))}
            </ul>
        </nav>

    </div>
</header>

<style lang="scss">

    .header-initial {
        position: sticky;
        top: 0;
        z-index: 100;

        height: var(--header-height);
        background-color: var(--colour-primary);
        border-radius: 0 0 0px 0px;
        transition: border-radius 0.3s ease, box-shadow 0.3s ease;

        box-shadow: 0px 7px 7px 0px rgba(0,0,0,0.25);
        display: flex;
        justify-content: center;

    }

    .header-initial.scrolled {
        border-radius: 0 0 20px 20px;
    }

    .header-container
    {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        height: 100%;
        width: 100%;
        padding: 0 1rem;
        box-sizing: border-box;
    }

    .left-group
    {
        display: flex;
        flex-direction: row;
        align-items: center;
        text-decoration: none;
        cursor: pointer;
    }

    .logo {
        height: var(--header-height);
    }

    .vert-separator
    {
        height: calc(var(--header-height) - var(--header-height) * 0.2);
        background-color: var(--colour-dark);
        width: 2px;
        border-radius: 999px;
        margin-left: 1rem;
        margin-right: 1.2rem;
        flex-shrink: 0;
    }

    .header-text {
        font-family: var(--font-primary);
        font-weight: 700;
        font-size: 2.5rem;
        color: var(--colour-dark);
        padding: 0;
        margin: 0;
        height: 100%;
        align-content: center;
        white-space: nowrap;
    }

    .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .nav-item {
        display: flex;
        align-items: center;
    }

    .nav-item a {
        font-family: var(--font-primary);
        text-decoration: none;
        color: var(--colour-white);
        font-weight: bold;
        font-size: 2.1rem;
        padding-left: 1.1rem;
        padding-right: 1.1rem;
        transition: color 0.2s;
    }

    .nav-item a:hover {
        color: var(--colour-dark);
    }

    .nav-item a.active {
        color: var(--colour-dark);
    }

    .nav-bullet {
        display: none;
    }

    .nav-divider {
        height: 2rem;
        width: auto;
        color: var(--colour-white);
    }

    /* Mobile Styling */
    .hamburger-btn {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;

        width: 30px;
        height: 21px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 110;

        margin-top: auto;
        margin-bottom: auto;
        margin-right: 0.5rem;
    }

    .hamburger-line {
        width: 100%;
        height: 3px;
        background-color: var(--colour-light);
        border-radius: 999px;
        transition: all 0.3s ease-in-out;
    }

    /* Morph lines into an 'X' icon when active */
    .hamburger-btn.is-active .hamburger-line:nth-child(1) {
        transform: translateY(9px) rotate(45deg);
        background-color: var(--colour-dark);
    }
    .hamburger-btn.is-active .hamburger-line:nth-child(2) {
        opacity: 0;
    }
    .hamburger-btn.is-active .hamburger-line:nth-child(3) {
        transform: translateY(-9px) rotate(-45deg);
        background-color: var(--colour-dark);
    }

    @media(#{$mobile}) {
        .hamburger-btn {
            display: flex;
        }

        .header-container {
            padding: 0 0.75rem;
        }

        .nav-divider {
            display: none;
        }

        .nav-item {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            width: fit-content;
        }

        .nav-bullet {
            display: block;
            width: 2rem;
            height: 2rem;
            color: var(--colour-white);
            transition: color 0.2s;
        }

        .logo {
            height: calc(var(--header-height) * 0.8);
        }

        .vert-separator {
            margin-left: 0.6rem;
            margin-right: 0.6rem;
        }

        .header-text{
            font-size: 1.8rem;
        }

        .nav-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100dvh;
            background-color: var(--colour-primary);
            padding-top: calc(var(--header-height) + 2rem);
            box-sizing: border-box;

            /* Center elements column style */
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;

            /* Start hidden */
            opacity: 0;
            pointer-events: none;
            transform: translateY(-10px);
            transition: all 0.3s ease-in-out;
            z-index: 105;
        }

        .nav-menu.is-open {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        .nav-links {
            flex-direction: column;
            gap: 3rem;
            width: 100%;
            align-items: center;
        }

        .nav-item a {
            font-size: 3rem;
            padding-left: 0;
            padding-right: 0;
        }
    }

</style>

<script>
    function initHeader() {
        const header = document.getElementById('main-header');
        const menuToggle = document.getElementById('menu-toggle');
        const navMenu = document.getElementById('nav-menu');
        const snapContainer = document.querySelector('.snap-scroll-container');

        if (!header || !menuToggle || !navMenu) return;

        // Hamburger Toggle Action
        menuToggle.addEventListener('click', () => {
            const isOpen = navMenu.classList.toggle('is-open');
            menuToggle.classList.toggle('is-active');
            menuToggle.setAttribute('aria-expanded', String(isOpen));
        });

        // Scroll Verification Action
        const checkScroll = (scrollTarget: Window | Element) => {
            const scrollTop = scrollTarget instanceof Window ? window.scrollY : scrollTarget.scrollTop;
            if (scrollTop > 0) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        };

        // Initialize and bind correctly outside nested functions
        if (snapContainer) {
            checkScroll(snapContainer);
            snapContainer.addEventListener('scroll', () => checkScroll(snapContainer), { passive: true });
        } else {
            checkScroll(window);
            window.addEventListener('scroll', () => checkScroll(window), { passive: true });
        }
    }

    // Load hooks execution layout
    initHeader();
    document.addEventListener('astro:page-load', initHeader);
</script>
