---
// src/components/PawHeader.astro

import Icon from "../components/Icon.astro"

interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div class="page-header">
    <div class="paw-line">
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
    </div>
    <h1 class="header-text">{text}</h1>
    <div class="paw-line">
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
    </div>
</div>

<style lang="scss">
    .page-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    .paw-line {
        display: flex;
        flex-direction: row;
        align-items: center;
        align-self: center;
        gap: 2.5rem;
    }

    .header-text {
        padding: 1rem 2rem;
        font-family: var(--font-primary);
        font-size: 2.5rem;
        color: var(--colour-white);
        text-align: center;
    }

    .paw-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--colour-dark);
    }

    /* Small Desktop Styling */
    @media (#{$small-desktop}) {
      .paw-line {
        gap: 3rem;
      }

      .paw-icon:nth-child(n+7) {
        display: none;
      }
    }
    /* Mobile Styling */
    @media (#{$mobile}) {
        .header-text {
            font-size: 1.8rem;
            padding: 1rem 1rem;
            white-space: normal;
        }

        .paw-line {
            gap: 1rem;
        }

        .paw-icon:nth-child(n+2) {
            display: none;
        }
    }
</style>