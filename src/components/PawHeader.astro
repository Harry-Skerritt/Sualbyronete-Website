---
// src/components/PawHeader.astro

import Icon from "../components/Icon.astro"

interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div class="page-header">
    <div class="paw-line">
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
    </div>
    <h1 class="header-text">{text}</h1>
    <div class="paw-line">
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
        <Icon name="paw-print" class="paw-icon" />
    </div>
</div>

<style lang="scss">
    .page-header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 100vw;
      padding: 1rem;
      box-sizing: border-box;
      overflow: hidden;
      gap: 1.5rem;
    }

    .paw-line {
      display: flex;
      flex-direction: row;
      align-items: center;
      align-self: center;
      gap: clamp(1rem, 2.5vw, 3rem);
      flex-shrink: 1;
      overflow: hidden;
      white-space: nowrap;
    }

    .header-text {
      padding: 0.5rem 1rem;
      font-family: var(--font-primary);
      font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.8rem);
      color: var(--colour-white);
      text-align: center;
      white-space: normal;
      flex-shrink: 0;
    }

    .paw-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--colour-dark);
    }

    /* Small Desktop Styling */
    @media (#{$small-desktop}) {
      .paw-line {
        gap: 1rem;
      }

      .paw-icon:nth-child(n+6) {
        display: none;
      }
    }
    /* Mobile Styling */
    @media (#{$mobile}) {
        .header-text {
            font-size: 1.8rem;
            padding: 1rem 1rem;
            white-space: normal;
        }

        .paw-line {
            gap: 1rem;
        }

        .paw-icon:nth-child(n+2) {
            display: none;
        }
    }
</style>