---
// src/components/Footer.astro

const currentYear = new Date().getFullYear()
const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
    <div class="footer-content">
        <p>
            <a href="#" id="admin-door" class="hidden-toggle">&copy;</a>
            {currentYear} <span class="accent">Sualbyronete</span>. All rights reserved.
        </p>
        <p>Website Designed and Built by <a href="https://harryskerritt.co.uk">harryskerritt.co.uk</a></p>
    </div>
</footer>

<style lang="scss">
    footer {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        padding: 1.5rem 2rem;
        margin-top: auto;
        border-top: 5px solid var(--colour-dark);
        font-family: var(--font-primary);
        background-color: var(--colour-primary);
    }

    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--colour-white);
        opacity: 0.8;
    }

    .accent {
        color: var(--colour-dark);
        font-weight: bold;
    }

    p {
        margin: 0;
        font-size: 1rem;
    }

    a {
        text-decoration: underline;
        color: var(--colour-white);
        transition: color 0.2s;
    }

    a:hover {
        color: var(--colour-dark);
    }


    .hidden-toggle {
      color: inherit;
      text-decoration: none;
      cursor: default;

      &:hover {
        color: inherit;
        text-decoration: none;
        cursor: default;
      }
    }

    /* Mobile Styling */
    @media(#{$mobile})
    {
        footer {
            padding: 1.5rem 1rem;
        }

        .footer-content {
            flex-direction: column;
            text-align: center;
            gap: 0.8rem;
        }

        p {
            font-size: 0.95rem;
            line-height: 1.4;
        }
    }

</style>

<script>
    const adminTrigger = document.getElementById('admin-door');
    if (adminTrigger) {
        adminTrigger.addEventListener('click', (e) => {
            e.preventDefault();

            const currentHost = window.location.hostname;
            const baseHost = currentHost.replace(/^admin\./, '');
            const portString = window.location.port ? `:${window.location.port}` : '';
            window.location.href = `${window.location.protocol}//admin.${baseHost}${portString}/`;
        });
    }
</script>