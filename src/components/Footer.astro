---
// src/components/Footer.astro

const currentYear = new Date().getFullYear()
const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
    <div class="footer-content">

        <div class="copyright">
            <p>
                <a href="#" id="admin-door" class="hidden-toggle">&copy;</a>
                {currentYear} <span class="accent">Sualbyronete</span>. All rights reserved.
            </p>
        </div>

        <div class="policy-links">
            <a href={`${baseURL}/privacy`} class="policy-link">Privacy Policy</a>
            <span class="link-divider" aria-hidden="true">|</span>
            <a href={`${baseURL}/cookies`} class="policy-link">Cookie Policy</a>
            <span class="link-divider" aria-hidden="true">|</span>
            <a href={`${baseURL}/tos`} class="policy-link">Terms of Service</a>
        </div>

        <div class="designer-credit">
            <p>Website designed and created by <a href="https://harryskerritt.co.uk" target="_blank" rel="noopener noreferrer" class="credit-link">harryskerritt.co.uk</a></p>
        </div>
    </div>
</footer>

<style lang="scss">
    footer {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        padding: 1.5rem 2rem;
        margin-top: auto;
        border-top: 5px solid var(--colour-dark);
        font-family: var(--font-primary);
        background-color: var(--colour-primary);
    }

    .footer-content {
        max-width: 110rem;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--colour-white);
        opacity: 0.8;
    }

    .accent {
        color: var(--colour-dark);
        font-weight: bold;
    }

    p {
      margin: 0;
      font-size: 1rem;
      font-weight: 400;
      color: var(--colour-white);
      opacity: 0.9;
      line-height: 1.5rem;
    }


    .policy-links {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }


    a {
        text-decoration: underline;
        color: var(--colour-white);
        transition: color 0.2s;
    }

    a:hover {
        color: var(--colour-dark);
    }


    .hidden-toggle {
      color: inherit;
      text-decoration: none;
      cursor: default;

      &:hover {
        color: inherit;
        text-decoration: none;
        cursor: default;
      }
    }

    /* Mobile Styling */
    @media(#{$mobile})
    {
        footer {
            padding: 1.5rem 1rem;
        }

        .footer-content {
            flex-direction: column;
            text-align: center;
            gap: 0.8rem;
        }

        p {
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .policy-links {
            a {
              font-size: 0.9rem;
            }
        }
    }

</style>

<script>
    const adminTrigger = document.getElementById('admin-door');
    if (adminTrigger) {
        adminTrigger.addEventListener('click', (e) => {
            e.preventDefault();

            const currentHost = window.location.hostname;
            const baseHost = currentHost.replace(/^admin\./, '');
            const portString = window.location.port ? `:${window.location.port}` : '';
            window.location.href = `${window.location.protocol}//admin.${baseHost}${portString}/`;
        });
    }
</script>