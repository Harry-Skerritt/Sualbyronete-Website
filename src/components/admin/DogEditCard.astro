---
// src/components/admin/DogEditCard.astro

interface Props {
    image?: string;
    breed?: string;
    gender?: string;
    name?: string;
    addDate?: string;
    dataId?: string;
}

const {
    image = "default.png",
    breed = "Unknown Breed",
    gender = "Unknown",
    name = "Unnamed Dog",
    addDate = "01-01-2026",
    dataId = ""
} = Astro.props;

import { Icon } from 'astro-icon/components'
import { formatGender } from "../../config/puppyConstants";

---

<div class="dog-edit-card">
    <div class="image-frame">
        <img src={image} alt={`Profile portrait photo of ${name}`} class="card-image"/>
    </div>

    <div class="metadata-panel">
        <h3 class="card-name">{name}</h3>
        <p class="card-breed">{formatGender(gender)} | {breed === "yorkie" ? "Yorkshire Terrier" : "Biewer Terrier" }</p>
        <p class="card-date">Added on: {addDate}</p>
    </div>

    <div class="control-actions">
        <button type="button" class="action-btn edit" title={`Edit ${name}'s profile parameters`} aria-label="Edit settings">
            <Icon name="edit" class="card-icon"/>
        </button>
        <button type="button" class="action-btn delete" title={`Remove ${name} permanently from system database`} aria-label="Delete entry">
            <Icon name="bin" class="card-icon"/>
        </button>
    </div>
</div>

<style lang="scss">
  .dog-edit-card {
    width: 100%;
    max-width: 44rem;
    height: 11.5rem;
    background-color: var(--colour-primary);
    filter: brightness(1.1);
    border: 4px solid var(--colour-dark);
    border-radius: 1.6rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 1.2rem;
    box-sizing: border-box;
    gap: 1.5rem;
    position: relative;
  }

  /* Left */
  .image-frame {
    width: 9rem;
    height: 9rem;
    border-radius: 1.2rem;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #dbdbdb;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Middle */
  .metadata-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 9rem;
    flex: 1;
    min-width: 0;
  }

  .card-name {
    font-family: var(--font-primary);
    font-size: 2.6rem;
    font-weight: 900;
    color: var(--colour-dark);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-breed {
    font-family: var(--font-secondary);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--colour-white);
    margin: 0;
  }

  .card-date {
    font-family: var(--font-secondary);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--colour-white);
    margin: 0;
  }

  /* Right */
  .control-actions {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 9rem;
    padding-right: 0.5rem;
  }

  .action-btn {
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    color: var(--colour-dark);
    transition: transform 0.1s ease, opacity 0.2s ease;
    background: transparent;

    &:hover {
      opacity: 0.8;
      transform: scale(1.05);
    }

    &:active {
      transform: scale(0.95);
    }
  }

  .card-icon {
    width: 2.6rem;
    height: 2.6rem;
    pointer-events: none;
  }
</style>