---
// src/components/admin/Toast.astro
---

<div id="global-toast" class="toast-hidden" role="alert" aria-live="assertive">
    <span class="toast-icon" id="toast-icon">✓</span>
    <span id="toast-text">Changes saved successfully!</span>
</div>

<style lang="scss">
  #global-toast {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: #10b981;
    color: white;
    font-family: var(--font-secondary, sans-serif);
    font-weight: 600;
    padding: 1rem 2rem;
    border-radius: 50px;
    box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.4);
    z-index: 99999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), top 0.3s ease;

    &.toast-hidden {
      opacity: 0;
      pointer-events: none;
      top: 1rem;
    }

    &.toast-visible {
      opacity: 1;
      top: 2rem;
    }

    &.toast-error {
      background-color: #ef4444;
      box-shadow: 0 10px 25px -5px rgba(239, 68, 68, 0.4);
    }

    .toast-icon {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 24px;
      height: 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
    }
  }

  @media (#{$mobile}) {
    #global-toast {
      white-space: normal;
      width: calc(100% - 2rem);
      max-width: 450px;
      padding: 0.85rem 1.25rem;
      border-radius: 12px;
      font-size: 0.95rem;
      box-sizing: border-box;

      &.toast-hidden {
        top: 0rem;
        transform: translateX(-50%) scale(0.95);
      }

      &.toast-visible {
        top: 1rem;
        transform: translateX(-50%) scale(1);
      }
    }
  }
</style>

<script>
    window.showToast = function(message: string, isError: boolean = false) {
        const toast = document.getElementById('global-toast');
        const textSpan = document.getElementById('toast-text');
        const iconSpan = document.getElementById('toast-icon');

        if (!toast || !textSpan || !iconSpan) return;

        // Set message text
        textSpan.innerText = message;

        // Toggle error vs success styling
        if (isError) {
            toast.classList.add('toast-error');
            iconSpan.innerText = "✕";
        } else {
            toast.classList.remove('toast-error');
            iconSpan.innerText = "✓";
        }

        // Trigger animation slide-in
        toast.className = `toast-visible${isError ? ' toast-error' : ''}`;

        // Automatically hide it after 3 seconds
        setTimeout(() => {
            toast.className = "toast-hidden";
        }, 3000);
    }

    declare global {
        interface Window {
            showToast: (message: string, isError?: boolean) => void;
        }
    }
</script>