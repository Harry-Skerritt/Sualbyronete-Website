---
// src/components/admin/CarouselSelectCard.astro

import { Switch } from 'free-astro-components'

interface Props {
    image?: string;
    breed?: string;
    name?: string;
    dataId?: string;
    showInCarousel: boolean;
}

const {
    image = "default.png",
    breed = "Unknown Breed",
    name = "Unnamed Dog",
    showInCarousel = false,
    dataId = ""
} = Astro.props;


---

<div class="carousel-select-card" data-id={dataId}>

    <div class="image-frame">
        <img
                src={`/images/puppies/${breed.toLowerCase() === 'yorkie' ? 'yorkies' : 'biewers'}/${image}`}
                alt={`Profile portrait photo of ${name}`}
                class="card-image"
        />
    </div>

    <div class="card-content">
        <div class="metadata-panel">
            <h3 class="card-name">{name}</h3>
            <p class="card-breed">{breed.toLowerCase() === "yorkie" ? "Yorkshire Terrier" : "Biewer Terrier"}</p>
        </div>

        <div class="control-panel">
            <Switch label="Show in Carousel" checked={showInCarousel} name={`carousel-${dataId}`} />
        </div>
    </div>

</div>

<style lang="scss">
  .carousel-select-card {
    display: flex;
    flex-direction: column;
    background-color: var(--colour-dark);
    border: 1px solid var(--colour-light);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    max-width: 320px;
    width: 100%;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
    }
  }

  .image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f8fafc;
    overflow: hidden;
    border-bottom: 1px solid var(--colour-light);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    gap: 1rem;
    flex-grow: 1;
  }

  .metadata-panel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-name {
    font-family: var(--font-primary);
    font-size: 2rem;
    color: var(--colour-light);
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .card-breed {
    font-family: var(--font-secondary);
    font-size: 0.875rem;
    color: var(--colour-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .control-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--colour-light);

    --ac-primary: var(--colour-primary);
    --ac-primary-hover: var(--colour-light);
    --ac-outline-color: var(--colour-light);

    :global(.ac-switch-wrapper) {
      display: flex;
      width: 100%;
      position: relative;
      box-sizing: border-box;
      font-family: var(--font-secondary, sans-serif);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--colour-primary) !important;
    }

    :global(.ac-switch-label) {
      order: 1 !important;
      margin-right: auto !important;
      color: var(--colour-primary) !important;
      transition: color 0.3s ease-in-out;
    }


    :global(.ac-switch:checked + .ac-switch-dot + .ac-switch-label),
    :global(.ac-switch:checked ~ .ac-switch-label),
    :global(.ac-switch:hover ~ .ac-switch-label) {
      color: var(--colour-light) !important;
    }

    :global(.ac-switch) {
      order: 2;
      border-color: var(--colour-light) !important;
      background-color: transparent !important;

      &:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        border-color: var(--colour-primary) !important;
      }
    }

    :global(.ac-switch:checked) {
      background-color: var(--colour-primary) !important;
      border-color: var(--colour-primary) !important;

      &:hover {
        background-color: var(--colour-light) !important;
        border-color: var(--colour-light) !important;
      }
    }

    :global(.ac-switch-dot) {
      left: auto;
      right: calc(var(--ac-spacing-10, 2.5rem) - var(--ac-spacing-5, 1.25rem) - var(--ac-spacing-0-5, 0.125rem));
      background-color: var(--colour-white, #ffffff) !important;
      box-shadow: none !important;
    }

    :global(.ac-switch:checked + .ac-switch-dot) {
      transform: translateX(var(--ac-spacing-4, 1rem)) translateY(-50%);
      background-color: var(--colour-dark) !important;
    }
  }
</style>