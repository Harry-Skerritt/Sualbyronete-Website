---
// src/components/admin/AdminHeader.astro
import {Icon} from "astro-icon/components";

const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '');
---


<header id="main-header" class="header-initial">
    <div class="header-container">
        <!-- Title -->
        <a href={`${baseURL}/dashboard`} style="text-decoration: none">
            <h1 class="header-text">Sualbyronete Admin Dashboard</h1>
        </a>
        <div class="buttons">
            <button id="help-button" class="button help" aria-label="Home Button">Home</button>
            <button id="logout-button" class="button logout" aria-label="Log out Button">Log Out</button>
        </div>



    </div>
</header>


<style lang="scss">
    .header-initial {
      position: sticky;
      top: 0;
      z-index: 100;

      height: var(--header-height);
      background-color: var(--colour-primary);
      border-radius: 0 0 0px 0px;
      transition: border-radius 0.3s ease, box-shadow 0.3s ease;

      box-shadow: 0px 7px 7px 0px rgba(0,0,0,0.25);
      display: flex;
      justify-content: center;
    }

    .header-initial.scrolled {
      border-radius: 0 0 20px 20px;
    }

    .header-container
    {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    .header-text {
      font-family: var(--font-primary);
      color: var(--colour-dark);
      font-weight: 900;
    }

    .button {
      width: 8rem;
      height: 3rem;
      border-radius: 0.7rem;
      border: none;
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 600;
      margin-right: 1rem;
      transition: all 0.15s ease;
      color: var(--colour-white);
    }

    .button:hover {
      filter: brightness(1.1);
    }

    .button:active {
      transform: scale(0.98);
    }

    .help {
      background-color: var(--colour-primary);
      border: 3px solid var(--colour-dark);
    }

    .logout {
      background-color: var(--colour-dark);

    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        const homeBtn = document.getElementById("help-button");
        if (homeBtn) {
            homeBtn.addEventListener("click", () => {
                const currentHost = window.location.hostname;
                const mainHost = currentHost.replace(/^admin\./, '');
                window.location.href = `${window.location.protocol}//${mainHost}${window.location.port ? ':' + window.location.port : ''}/`;
            })
        }

        const logoutBtn = document.getElementById("logout-button");
        if (logoutBtn) {
            logoutBtn.addEventListener("click", async () => {
                try {
                    const response = await fetch('/admin/auth/logout-submit', {
                        method: 'POST'
                    });

                    const data = await response.json() as { success: boolean; redirect: string };

                    if (response.ok && data.success) {
                        window.location.href = data.redirect;
                    } else {
                        console.error("Server rejected logout transaction request");
                    }
                } catch (err) {
                    console.error("Logout runtime failure execution:", err);
                }
            });
        }
    })
</script>
