---
// src/components/admin/AdminHeader.astro
import {Icon} from "astro-icon/components";
import {SITE_NAME} from "../../config/siteSettings";

const baseURL = import.meta.env.BASE_URL.replace(/\/$/, '');
---


<header id="main-header" class="header-initial">
    <div class="header-container">
        <!-- Title -->
        <a href={`${baseURL}/dashboard`} style="text-decoration: none">
            <h1 class="header-text full-title">{SITE_NAME} Admin Dashboard</h1>
            <h1 class="header-text short-title">Admin Dashboard</h1>
        </a>

        <div class="buttons">
            <button id="help-button" class="button help" aria-label="Home Button">Home</button>
            <button id="help-button-mobile" class="button-mobile help" aria-label="Home Button"><Icon name="home" class="icon"/></button>
            <button id="logout-button" class="button logout" aria-label="Log out Button">Log Out</button>
            <button id="logout-button-mobile" class="button-mobile logout" aria-label="Log out Button"><Icon name="logout" class="icon"/></button>
        </div>
    </div>
</header>


<style lang="scss">
    .header-initial {
      position: sticky;
      top: 0;
      z-index: 100;

      height: var(--header-height);
      background-color: var(--colour-primary);
      border-radius: 0 0 0px 0px;
      transition: border-radius 0.3s ease, box-shadow 0.3s ease;

      box-shadow: 0px 7px 7px 0px rgba(0,0,0,0.25);
      display: flex;
      justify-content: center;
    }

    .short-title {
      display: none;
    }

    .header-initial.scrolled {
      border-radius: 0 0 20px 20px;
    }

    .header-container
    {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      height: 100%;
      width: 100%;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    .header-text {
      font-family: var(--font-primary);
      color: var(--colour-dark);
      font-weight: 900;
    }

    .button, .button-mobile {
      width: 8rem;
      height: 3rem;
      border-radius: 0.7rem;
      border: none;
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 600;
      margin-right: 1rem;
      transition: all 0.15s ease;
      color: var(--colour-white);
    }

    .button-mobile {
      display: none;
    }

    .button:hover {
      filter: brightness(1.1);
    }

    .button:active {
      transform: scale(0.98);
    }

    .help {
      background-color: var(--colour-primary);
      border: 3px solid var(--colour-dark);
    }

    .logout {
      background-color: var(--colour-dark);

    }

    /* Mobile Styling */
    @media (#{$mobile}) {
      .header-container {
        padding: 0 1rem;
      }

      .header-text {
        font-size: 1.6rem;
      }

      .header-initial {
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
      }

      .full-title {
        display: none;
      }

      .short-title {
        display: inline;
      }

      .header-text {
        font-size: 1.5rem;
      }

      .buttons {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        width: 30%;
      }

      .button {
        display: none;
      }

      .button-mobile {
        display: flex;
        width: 3rem;
        height: 3rem;
        color: var(--colour-white);
        flex-direction: row;
        justify-content: center;
        align-items: center;
        .icon {
          width: 2rem;
          height: 2rem;
        }
      }

    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        /* Home */
        const handleHomeRedirect = () => {
            const currentHost = window.location.hostname;
            const mainHost = currentHost.replace(/^admin\./, '');
            window.location.href = `${window.location.protocol}//${mainHost}${window.location.port ? ':' + window.location.port : ''}/`;
        };

        document.getElementById("help-button")?.addEventListener("click", handleHomeRedirect);
        document.getElementById("help-button-mobile")?.addEventListener("click", handleHomeRedirect);

        /* Logout */
        const handleLogoutSubmit = async () => {
            try {
                const response = await fetch('/admin/auth/logout-submit', {
                    method: 'POST'
                });

                const data = await response.json() as { success: boolean; redirect: string };

                if (response.ok && data.success) {
                    window.location.href = data.redirect;
                } else {
                    console.error("Server rejected logout transaction request");
                }
            } catch (err) {
                console.error("Logout runtime failure execution:", err);
            }
        };

        document.getElementById("logout-button")?.addEventListener("click", handleLogoutSubmit);
        document.getElementById("logout-button-mobile")?.addEventListener("click", handleLogoutSubmit);
    })
</script>
