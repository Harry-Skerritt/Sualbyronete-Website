---
// src/pages/adults.astro
import Layout from "../../layouts/Layout.astro";
import PawHeader from "../../components/PawHeader.astro";
import TabbedFilter from "../../components/TabbedFilter.astro";

import { getCachedData } from "../../scripts/databaseCache";
import ParentCard from "../../components/ParentCard.astro";
import {SITE_NAME} from "../../config/siteSettings";

const { parents } = await getCachedData();
---

<Layout title=`Adults | ${SITE_NAME}`>
    <main>

        <PawHeader text="Parent Dogs"/>

        <div class="filter-parent">

            <!-- Breed Filter -->
            <div class="tab-filter">
                <TabbedFilter
                        option_one="Yorkshire Terriers"
                        option_one_icon="paw-print"
                        option_one_value="yorkie"
                        option_two="Biewer Terriers"
                        option_two_icon="paw-print"
                        option_two_value="biewer"
                        default_selected={1}
                        custom_event_name="aBreedChange"
                        class="breed-filter"
                />
            </div>

            <!-- Parent Selector -->
            <div class="tab-filter">
                <TabbedFilter
                        option_one="Dams"
                        option_one_icon="gender/female"
                        option_one_value="female"
                        option_two="Sires"
                        option_two_icon="gender/male"
                        option_two_value="male"
                        default_selected={1}
                        custom_event_name="aGenderChange"
                        class="gender-filter"
                />
            </div>
        </div>

        <!-- Content Grid -->
        <div id="puppy-grid" class="parent-grid">
            {parents.map((parent: any) => (
                    <div class="parent-card-wrapper"
                         data-breed={parent.breed}
                         data-gender={parent.gender ? parent.gender.toLowerCase() : ''}>

                        <ParentCard
                                parentName={parent.name}
                                parentDoB={parent.dob}
                                parentImage={parent.image}
                                parentColour={parent.colour}
                                parentBreed={parent.breed}
                                parentForSale={parent.forSale}
                                parentID={parent.id || ``}
                                parentBio = {parent.bio}

                        />

                    </div>
            ))}



            <div id="no-results-message" class="no-results" style="display: none;">
                No parents match your selected filter criteria.
            </div>
        </div>

    </main>
</Layout>


<style lang="scss">
  :root {
    --max-display-width: 117rem;

    @media (#{$small-desktop}) {
      --max-display-width: 92rem;
    }
  }

  .filter-parent {
    max-width: var(--max-display-width);
    margin: 0 auto;

    @media (#{$small-desktop}) {
      padding: 0 1rem;
    }
  }

  /* Tab Filters */
  .tab-filter {
    border: 2px solid var(--colour-dark);
    border-radius: 0.9rem;
    padding: 0.3rem;
    width: 100%;
    margin-bottom: 1rem;
  }

  .parent-grid {
    border: 2px solid var(--colour-dark);
    max-width: var(--max-display-width);
    margin: 0 auto 2rem;
    border-radius: 0.6rem;
    padding: 2rem;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;

    justify-items: center;
    justify-content: center;

    @media (#{$small-desktop}) {
      padding: 1.5rem;
      gap: 0.6rem;
    }
  }

  :global(.no-results) {
    grid-column: 1/-1;
    padding: 2rem;
    text-align: center;
    font-weight: bold;
    font-family: var(--font-secondary);
    color: var(--colour-dark);
    font-size: 1.2rem;
  }

  /* Mobile Styling */
  @media (#{$mobile}) {
    .filter-parent ,
    .parent-grid {
      width: calc(100% - 2rem) !important;
      margin-left: 1rem !important;
      margin-right: 1rem !important;
      box-sizing: border-box;
    }

    .parent-grid {
      padding: 1rem;
      gap: 1.5rem;
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>

<script is:inline set:html={`
    window.PARENT_DATA = ${JSON.stringify(parents)};
`} />

<script src="../../scripts/parentFilter.ts"></script>
