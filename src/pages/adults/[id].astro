---
// src/pages/adults/[id].astro

import Layout from "../../layouts/Layout.astro"

import { getDB } from "../../db/index";
import { adults } from "../../db/schema";
import { calculateAge } from "../../scripts/ageCalculator";
import { eq } from "drizzle-orm";

const { id } = Astro.params;
if (!id) {
    return Astro.redirect('/404');
}

const db = getDB();

const adultArray = await db.select().from(adults).where(eq(adults.id, id));
const parent = adultArray[0];

if (!parent) {
    return Astro.redirect('/404');
}


import { getColourLabel, formatGender } from "../../config/puppyConstants";
---

<Layout title={`Meet ${parent.name} | Sualbyronete`}>
    <main class="parent-info-container">

        <!-- Left Hand Content (Image & Pricing) -->
        <div class="left-content">
            <div class="parent-image">
                <div class=`parent-status-badge ${parent.forSale === true ? '' : 'hidden'}`>
                    <h1 class="parent-status">For Sale</h1>
                </div>

                <img
                        src={`/images/adults/${parent.image}`}
                        alt={`${parent.breed.toLowerCase() === 'yorkie' ? 'Yorkshire Terrier' : 'Biewer Terrier'} parent`}
                        class={`parent-photo ${parent.forSale ? '' : 'not-for-sale'}`}
                />
            </div>

            {parent.forSale && (
                    <div class="pricing-section">
                    <span class="pricing-text">
                        For Pricing please
                        <a href={`/contact?ref=${parent.id}&name=${parent.name}`} class="pricing-contact">Contact Me</a>
                    </span>

                        <span class="deposit-text">
                        <span class="accent">*</span>
                        All dogs require a non-refundable reservation deposit of £100.
                        This will ensure your dog is held for X days
                    </span>
                    </div>
            )}
        </div>

        <!-- Right Hand Content (parent Info) -->
        <div class="right-content">
            <div class="parent-main-header">
                <p class="parent-name">{formatGender(parent.name)}</p>
                <span class="parent-description">
                    {parent.bio}
                </span>
            </div>

            <div class="horizontal-separator"/>

            <div class="info-lists">
                <dl class="parent-specs-list">
                    <dt>Breed:</dt>
                    <dd>{parent.breed.toLowerCase() === 'yorkie' ? 'Yorkshire Terrier' : 'Biewer Terrier'}</dd>

                    <dt>DoB:</dt>
                    <dd>{parent.dob}</dd>

                    <dt>Age:</dt>
                    <dd>{calculateAge(parent.dob)}</dd>

                    <dt>Gender:</dt>
                    <dd>{formatGender(parent.gender)}</dd>

                    <dt>Colour:</dt>
                    <dd>{getColourLabel(parent.colour)}</dd>

                    <dt>Puppies:</dt>
                    <dd><a href={`/puppies/litterView?parent=${parent.id}&name=${parent.name}`}>View Puppies</a></dd>

                    <dt>Reg #:</dt>
                    <dd>{parent.regID}</dd>
                </dl>
            </div>

        </div>


    </main>
</Layout>

<style lang="scss">

  .parent-info-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    max-width: 120rem;
    margin: 0 auto;
    padding: 2rem 3rem;
    box-sizing: border-box;
    gap: 4rem;

    min-height: calc(100vh - 12rem);
  }

  /* Left Content */
  .left-content {
    flex: 0 0 37rem;
    display: flex;
    flex-direction: column;
  }

  /* Image */
  .parent-image {
    width: 37rem;
  }

  .parent-status-badge {
    width: 100%;
    height: 4rem;
    border: 0.4rem solid var(--colour-light);
    border-bottom: none;
    border-radius: 1.2rem 1.2rem 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--colour-dark);
  }

  .parent-status {
    display: flex;
    color: var(--colour-white);
    font-family: var(--font-secondary);
    font-size: 2rem;
    text-align: center;
    margin: 0;
  }

  .parent-photo {
    width: 100%;
    height: 37rem;
    object-fit: cover;
    object-position: 0 20%;
    border-radius: 0 0 0.8rem 0.8rem;
    border: 0.4rem solid var(--colour-light);
    border-top: none;
    box-sizing: border-box;

    &.not-for-sale {
      border-top: 0.4rem solid var(--colour-light) !important;
      border-radius: 0.8rem !important;
    }
  }

  .hidden{
    display: none;
  }

  /* Pricing */
  .pricing-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 1.5rem;
    gap: 0.5rem
  }

  .pricing-text {
    font-size: 1.8rem;
    color: var(--colour-white);
    font-weight: bold;
  }

  .pricing-contact {
    color: var(--colour-dark);
  }

  .deposit-text {
    font-family: var(--font-secondary);
    font-size: 1rem;
    color: var(--colour-white);
    margin: 0;
  }

  .accent {
    color: var(--colour-dark);
  }


  /* Right Content */
  .right-content {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin: 0;
    padding: 0;
  }

  .parent-main-header {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .parent-name {
    font-family: var(--font-primary);
    font-size: 4rem;
    font-weight: bold;
    color: var(--colour-white);
    line-height: 4.4rem;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .parent-description {
    display: block;
    font-family: var(--font-secondary);
    color: var(--colour-white);
    width: 90%;
    height: 5rem;
    margin-top: 0.6rem;
    font-size: 1.2rem;
  }

  .horizontal-separator {
    width: 100%;
    height: 0.3rem;
    background-color: var(--colour-dark);
    border-radius: 999px;
    margin: 1rem 0;
  }

  /* Info Lists */
  .info-lists {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 3rem;
  }

  /* parent Info */
  .parent-specs-list {
    flex: 1;
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0.5rem 0px;
    margin: 1rem 0;
  }

  dt, dd {
    display: flex;
    align-items: center;
    height: 2.5rem;
    font-size: 1.3rem;
    box-sizing: border-box;
  }

  dt {
    font-family: var(--font-primary);
    font-weight: 900;
    color: var(--colour-dark);
    margin: 0;
    padding-left: 0.4rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0.5rem 0 0 0.5rem;
    border-right: none;
  }

  dd {
    font-family: var(--font-secondary);
    color: var(--colour-white);
    margin: 0;
    padding-left: 0.6rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0 0.5rem 0.5rem 0;
    border-left: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a {
    color: var(--colour-white);
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    &:hover { text-decoration: underline; }
  }

  dd a {
    display: inline-block;
    background-color: var(--colour-dark);
    padding: 0.2rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 1rem;
  }


  /* Mobile Styling */
  @media ($mobile) {
    .parent-info-container {
      flex-direction: column;
      padding: 1rem 1.5rem 4rem;
      gap: 2rem;
      min-height: auto;
    }

    .left-content {
      width: 100%;
      max-width: 100%;
      flex: none;
    }

    .parent-image {
      width: 100%;
      max-width: 100%;
    }

    .parent-photo {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .pricing-section {
      margin-top: 1.5rem;
      padding: 1.5rem;
      background-color: rgba(0, 0, 0, 0.15);
      border-radius: 0.8rem;
      border: 2px solid var(--colour-dark);
      box-sizing: border-box;
    }

    .pricing-text {
      font-size: 1.4rem;
      text-align: center;
    }

    .pricing-contact {
      display: inline-block;
      background-color: var(--colour-dark);
      color: var(--colour-light);
      padding: 0.3rem 0.8rem;
      border-radius: 0.4rem;
      margin-left: 0.3rem;
      margin-top: 1rem;
    }

    .deposit-text {
      font-size: 0.95rem;
      line-height: 1.3rem;
      text-align: center;
      margin-top: 0.4rem;
    }

    .right-content {
      width: 100%;
    }

    .parent-name {
      font-size: 2.8rem;
      line-height: 3.2rem;
    }

    .parent-description {
      width: 100%;
      font-size: 1.1rem;
      line-height: 1.5rem;
    }

    .info-lists {
      width: 100%;
    }

    .parent-specs-list {
      grid-template-columns: 8.5rem 1fr;
      gap: 0.6rem 0;
    }

    dt, dd {
      font-size: 1.15rem;
      height: 2.8rem;
    }

    dd a {
      display: inline-block;
      background-color: var(--colour-dark);
      padding: 0.2rem 0.8rem;
      border-radius: 0.4rem;
      font-size: 1rem;
    }
  }

</style>