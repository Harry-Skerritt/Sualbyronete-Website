---
// src/pages/contact.astro

import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

import {
    baseURL, BREEDER_IMAGE, BREEDER_NAME,
    CONTACT_NUMBER,
    FACEBOOK_LINK,
    INSTAGRAM_LINK,
    MESSENGER_LINK,
    SITE_NAME, TURNSTYLE_SITE_KEY,
    WHATSAPP_LINK
} from "../config/siteSettings";

// Get ref from URL
const { searchParams } = Astro.url;
const referenceCode = searchParams.get('ref') || "";
const puppyName = searchParams.get('name') || "";

const formattedValue = referenceCode
    ? (puppyName ? `${referenceCode} - ${puppyName}` : referenceCode)
    : "";

const isReadOnly = formattedValue.length > 0;

// Handle Success
const isSuccess = searchParams.get('success') === 'true';
const errorCode = searchParams.get('error');
---
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer/>

<Layout title=`Contact Me | ${SITE_NAME}`>
    <div id="url-state-tracker" data-success={isSuccess ? "true" : "false"} data-error={errorCode || ""} style="display: none;"></div>

    <main class="contact-container">
        <section class="left-panel">
            <span class="contact-header">CONTACT ME</span>

            <div class="breeder-container">
                <img src={`${baseURL}/${BREEDER_IMAGE.src}`} alt={BREEDER_IMAGE.alt} class="contact-image"/>
                <span class="contact-desc">{BREEDER_NAME}</span>
            </div>

            <div class="other-contact-container">
                <span class="phone-number">
                    Call Me:
                    <a href=`tel:+44${CONTACT_NUMBER}` class="accent">{CONTACT_NUMBER}</a>
                </span>

                <span class="social-header">Find me on Socials:</span>
                <div class="social-container">
                    <a href={INSTAGRAM_LINK} target="_blank" class="social-link">
                        <Icon name="social/instagram" class="social-contact"/>
                    </a>

                    <a href={FACEBOOK_LINK} target="_blank" class="social-link">
                        <Icon name="social/facebook" class="social-contact"/>
                    </a>

                    <a href={WHATSAPP_LINK} target="_blank" class="social-link">
                        <Icon name="social/whatsapp" class="social-contact"/>
                    </a>

                    <a href={MESSENGER_LINK} class="social-link" target="_blank">
                        <Icon name="social/messenger" class="social-contact"/>
                    </a>
                </div>
            </div>
        </section>

        <div class="vertical-separator"/>

        <section class="right-panel">
            <div class="contact-wrapper">
                <div class="contact-form-header">
                    <h2 class="form-header-text">Or use my contact form...</h2>
                </div>

                <form class="visual-form" action="/api/send-email" method="POST">

                    <div class="field-group-hp" aria-hidden="true">
                        <label for="middle-name">Middle Name</label>
                        <input
                                type="text"
                                id="middle-name"
                                name="middle_name"
                                tabindex="-1"
                                autocomplete="off"
                                placeholder="Middle name..."
                        />
                    </div>
                    <!-- Make this work once deployed -->

                    <div class="field">
                        <label for="name">Name <span class="required-marker">*</span> </label>
                        <input
                                type="text"
                                id="name"
                                name="name"
                                maxlength="50"
                                required placeholder="e.g. John Doe"

                        />
                    </div>

                    <div class="field">
                        <label for="email">Email <span class="required-marker">*</span> </label>
                        <input
                                type="email"
                                id="email"
                                name="email"
                                maxlength="50"
                                required placeholder="email@domain.com"
                        />
                    </div>

                    <div class="field">
                        <label for="reference">Dog Reference:</label>
                        <input
                                type="text"
                                id="reference"
                                name="reference"
                                placeholder="YTXXX"
                                maxlength="20"
                                value={formattedValue}
                                class={isReadOnly ? "locked-field" : ""}
                        />
                    </div>

                    <div class="field">
                        <label for="message">Message <span class="required-marker">*</span> </label>
                        <textarea
                                id="message"
                                name="message"
                                rows="6"
                                maxlength="300"
                                required placeholder="Write your message here..."
                        />
                    </div>

                    <label for="turnstile">Verification <span class="required-marker">*</span> </label>
                    <div class="cf-turnstile" data-sitekey={TURNSTYLE_SITE_KEY}></div> <!-- Make this work once deployed -->

                    <button type="submit" class="send-btn" id="submit-btn">
                        <span class="text">Send</span>
                    </button>
                </form>
            </div>
        </section>

    </main>

</Layout>

<style lang="scss">

    /* Root Parent */
    .contact-container {
      width: 100%;
      max-width: 115rem;
      margin: 0 auto;
      display: flex;
      flex-direction: row;
      padding: 3rem 2rem;
      box-sizing: border-box;
      align-items: flex-start;
    }

    /* Left Content */
    .left-panel {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      gap: 2.5rem;
      width: 32rem;
      flex-shrink: 0;
    }

    .contact-header {
      font-family: var(--font-primary);
      color: var(--colour-white);
      font-size: 3rem;
      font-weight: 900;
      line-height: 3.3rem;
      margin: 0;
      text-transform: uppercase;
      text-align: center;
    }

    /* Image */
    .breeder-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.6rem;
    }

    .contact-image {
      width: 22rem;
      height: 22rem;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 100%;
      border: 10px solid var(--colour-dark);
    }

    .contact-desc {
      font-family: var(--font-primary);
      color: var(--colour-white);
      font-size: 2rem;
      font-weight: bolder;
    }

    /* Phone Number */
    .other-contact-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      width: 100%;
    }

    .phone-number {
      margin-top: 0.5rem;
    }

    .phone-number, .social-header {
      font-family: var(--font-primary);
      color: var(--colour-white);
      font-size: 2rem;
      font-weight: 800;
      text-align: center;
    }

    .accent {
      color: var(--colour-dark);
      font-weight: 800;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: all 0.1s ease-in-out;

      &:hover {
        filter: brightness(1.1);
      }

      &:active {
        filter: brightness(0.9);
      }
    }

    /* Social */
    .social-container {
      display: flex;
      flex-direction: row;
      gap: 1.2rem;
      margin-top: 0.5rem;
    }

    .social-contact {
      width: 3rem;
      height: 3rem;
      color: var(--colour-dark);
      transition: all 0.1s ease-in-out;

      &:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
      }

      &:active {
        filter: brightness(0.9);
        transform: scale(0.95);
      }
    }

    /* Separator */
    .vertical-separator {
      height: 85vh;
      width: 0.3rem;
      background-color: var(--colour-dark);
      border-radius: 999px;
      margin: 0 3rem;
      align-self: center;
      flex-shrink: 0;
    }

    /* Contact Form */
    .right-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .contact-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    .contact-form-header {
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      height: 3.6rem;
    }

    .form-header-text {
      font-family: var(--font-primary);
      color: var(--colour-white);
      font-size: 2.4rem;
      font-weight: 800;
      margin: 0;
      line-height: 1.2rem;
    }

    /* Form Fields */
    .visual-form{
      display: flex;
      flex-direction: column;
      width: 100%;
      margin-top: 2.5rem;
      gap: 1.5rem;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex: 1;
    }

    .field textarea, input {
      resize: none;
      border-radius: 1.5rem;
    }

    label {
      font-family: var(--font-secondary);
      color: var(--colour-light);
      font-size: 1.1rem;
      letter-spacing: 1px;
    }

    .required-marker {
      color: #be4141;
    }

    .cf-turnstile {
      margin: -1rem 0 0 0;
    }

    input, select, textarea {
      background-color: rgba(255, 255, 255, 0);
      border: 4px solid var(--colour-light);
      padding: 1rem;
      color: var(--colour-light);
      font-family: var(--font-secondary);
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--colour-dark);
      background-color: var(--colour-primary);
      filter: brightness(0.95);
      box-shadow: 0 0 15px var(--colour-light);
    }

    input.locked-field {
      background-color: rgba(255, 255, 255, 0.05);
      border-style: dotted;
      cursor: not-allowed;
      opacity: 0.7;

      &:focus {
        border-color: var(--colour-light);
        background-color: rgba(255, 255, 255, 0.05);
        filter: none;
        box-shadow: none;
      }
    }

    /* Honey Pot */
    .field-group-hp {
      opacity: 0;
      position: absolute;
      top: 0;
      left: 0;
      height: 0;
      width: 0;
      z-index: -1;
      overflow: hidden;
      pointer-events: none;
    }

    .send-btn {
      background-color: var(--colour-dark);
      color: var(--colour-white);
      border: none;
      padding: 1.2rem;
      font-family: var(--font-secondary);
      font-weight: bold;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      justify-content: center;
      transition: all 0.2s;
      margin-top: 1rem;
      border-radius: 1rem;
    }

    .send-btn:hover {
      filter: brightness(1.1);
    }

    .send-btn:active {
      transform: scale(0.99);
      box-shadow: none;
    }

    .send-btn.submitting {
      opacity: 0.7;
      pointer-events: none;
      cursor: not-allowed;
    }

    /* Banners */
    .alert-banner {
      padding: 1.2rem 1.5rem;
      border-radius: 1rem;
      margin-top: 2rem;
      margin-bottom: -1rem;
      width: 100%;
      box-sizing: border-box;
      animation: slideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;

      .alert-text {
        font-family: var(--font-secondary);
        font-size: 1.1rem;
        margin: 0;
        line-height: 1.4;
      }

      &.success {
        background-color: #f0fdf4;
        color: #14532d;
        border: 2px solid #bbf7d0;
      }

      &.error {
        background-color: #fef2f2;
        color: #7f1d1d;
        border: 2px solid #fecaca;
      }
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Mobile Styling */
    @media (#{$mobile}) {
      .contact-container {
        flex-direction: column;
        align-items: stretch;
        padding: 1.5rem 1rem;
      }

      .left-panel {
        width: 100%;
        gap: 2rem;
      }

      .contact-header {
        font-size: 2.4rem;
      }

      .contact-image {
        width: 16rem;
        height: 16rem;
      }

      .vertical-separator {
        height: 0.3rem;
        width: 100%;
        margin: 2.5rem 0;
      }

      .contact-form-header {
        height: auto;
        margin-bottom: 1rem;
      }

      .form-header-text {
        font-size: 1.8rem;
        text-align: center;
        width: 100%;
      }
    }

</style>

<script>
    import { BREEDER_NAME_SHORT } from "../config/siteSettings";

    const form = document.querySelector('.visual-form');
    const btn = document.querySelector('#submit-btn');
    const btnText = btn?.querySelector('.text');
    const stateTracker = document.querySelector('#url-state-tracker') as HTMLElement;

    if (stateTracker && typeof window.showToast === 'function') {
        const isSuccess = stateTracker.getAttribute('data-success') === 'true';
        const errorFlag = stateTracker.getAttribute('data-error');

        if (isSuccess) {
            window.showToast(`Message sent! ${BREEDER_NAME_SHORT} will get back to you soon`);
        } else if (errorFlag) {
            window.showToast('Something went wrong sending your message. Please try again.', true);
        }

        stateTracker.removeAttribute('data-success');
        stateTracker.removeAttribute('data-error');
    }

    if (form && btn && btnText) {
        form.addEventListener('submit', (e) => {
            const turnstileResponse = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;

            // Check if Turnstile is completed
            if (!turnstileResponse) {
                e.preventDefault();
                alert('Please complete the security verification.');
                return;
            }

            btn.classList.add('submitting');
            btnText.textContent = "Sending...";
        });
    }
</script>