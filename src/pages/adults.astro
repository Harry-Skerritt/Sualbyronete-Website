---
// src/pages/adults.astro
import Layout from "../layouts/Layout.astro";
import { Icon } from 'astro-icon/components'
import PawHeader from "../components/PawHeader.astro";
import TabbedFilter from "../components/TabbedFilter.astro";
---

<Layout title="Adults | Sualbyronete">
    <PawHeader text="Parent Dogs"/>

    <div class="filter-parent">

        <!-- Breed Filter -->
        <div class="tab-filter">
            <TabbedFilter
                    option_one="Yorkshire Terriers"
                    option_one_icon="paw-print"
                    option_one_value="yorkie"
                    option_two="Biewer Terriers"
                    option_two_icon="paw-print"
                    option_two_value="biewer"
                    default_selected={1}
                    class="breed-filter"
            />
        </div>

        <!-- Parent Selector -->
        <div class="tab-filter">
            <TabbedFilter
                    option_one="Dams"
                    option_one_icon="female"
                    option_one_value="female"
                    option_two="Sires"
                    option_two_icon="male"
                    option_two_value="male"
                    default_selected={1}
                    class="parent-selector"
            />
        </div>
    </div>

</Layout>


<style lang="scss">

  .filter-parent {
    max-width: 1750px;
    margin: 0 auto;
  }

  /* Tab Filters */
  .tab-filter {
    border: 2px solid var(--colour-dark);
    border-radius: 0.9rem;
    padding: 0.3rem;
    width: 100%;
    margin-bottom: 1rem;
  }

  /* Mobile Styling */
  @media (#{$mobile}) {
    .filter-parent {
      width: calc(100% - 2rem) !important;
      margin-left: 1rem !important;
      margin-right: 1rem !important;
      box-sizing: border-box;
    }
  }
</style>
