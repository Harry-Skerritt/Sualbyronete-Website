---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import PhotoCarousel from "../components/PhotoCarousel.astro";

import { getCarouselGallery } from "../scripts/getFeaturedPuppies";
import {
    BREEDER_IMAGE,
    BREEDER_NAME_SHORT,
    HOME_PAGE_ABOUT,
    SITE_NAME,
    baseURL,
    SITE_DESCRIPTION
} from "../config/siteSettings";
const petGallery = await getCarouselGallery();
---

<Layout>
    <!-- Snap Scroll Containers -->
    <main class="snap-scroll-container">

        <!-- Section 1: Photo Carousel -->
        <section class="snap-section carousel-section">
            {petGallery.length > 0 ? (
                    <PhotoCarousel images={petGallery}/>
            ) : (
                    <div class="carousel-placeholder">
                        <img src={`${baseURL}/logo-basic/Logo-Basic.png`} alt=`${SITE_NAME} Welcome Banner` class="placeholder-bg" />
                        <div class="placeholder-overlay">
                            <h1>Welcome to {SITE_NAME}</h1>
                            <p>{SITE_DESCRIPTION}</p>
                        </div>
                    </div>
            )}
        </section>

        <!-- Section 2: About Section -->
        <section class="snap-section about-section">
            <img src={`${baseURL}/${BREEDER_IMAGE.src}`} alt={BREEDER_IMAGE.alt} class="breeder-image"/>

            <div class="text-container">
                <h1 class="about-header">Hi, I'm {BREEDER_NAME_SHORT}</h1>
                <p class="about-body">{HOME_PAGE_ABOUT}</p>
                <a class="read-more-about" href="/about">Read More</a>
            </div>

            <div class="secondary-image">
                <img src={`${baseURL}/images/grace.png`} alt="Grace playing in a field">
            </div>
        </section>


        <!-- Section 3: Nav Section -->
        <section class="snap-section nav-section">
            <div class="nav-images-container">
                <a href={`${baseURL}/puppies`} class="nav-image-wrapper">
                    <img src={`${baseURL}/images/nav/puppyDog.jpg`} alt="A Yorkshire Terrier puppy"/>
                    <h1 class="nav-image-header">Puppies</h1>
                    <p class="nav-image-subtext">See More</p>
                </a>

                <a href={`${baseURL}/adults`} class="nav-image-wrapper">
                    <img src={`${baseURL}/images/nav/adultDog.jpg`} alt="An adult Yorkshire Terrier"/>
                    <h1 class="nav-image-header">Adults</h1>
                    <p class="nav-image-subtext">See More</p>
                </a>
            </div>
        </section>

    </main>
</Layout>


<style lang="scss">
  :root {
    --border-px: 17px;
  }

  /* Scroll Framework */
  .snap-scroll-container {
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;

    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .snap-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .snap-section {
    width: 100%;
    height: 100%;
    min-height: calc(100vh - var(--header-height));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    box-sizing: border-box;
  }

  /* Section 1: Carousel */
  .carousel-section {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-section :global(.carousel-container) {
    max-width: 100% !important;
    width: 100%;
    height: 100%;
  }

  .carousel-section :global(.carousel-slide) {
    aspect-ratio: auto !important;
    height: calc(100vh - var(--header-height));
  }

  /* Carousel Fallback */
  .carousel-placeholder {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;

    .placeholder-bg {
      width: 100%;
      height: 50%;
      object-fit: contain;
    }

    .placeholder-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-top: 10rem;
      align-items: center;
      color: var(--colour-white);
      text-align: center;
      padding: 2rem;

      h1 {
        font-family: var(--font-primary);
        font-size: 4.5rem;
        margin: 0 0 1rem 0;
        text-transform: uppercase;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
      }

      p {
        font-family: var(--font-secondary);
        font-size: 1.8rem;
        margin: 0;
        text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
      }
    }
  }

  /* Section 2: About Section */
  .about-section {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 4rem 2rem 2rem 2rem;
    gap: 2rem;
  }
  .breeder-image {
    height: 80vh;
    width: auto;
    object-fit: cover;
    border: var(--border-px) solid var(--colour-white);
    margin: 0;
  }

  .text-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    align-self: flex-start;
  }

  .about-header{
    color: var(--colour-dark);
    font-family: var(--font-primary);
    font-size: 60px;
    margin: 0 0 1rem 0;
  }

  .about-body {
    color: var(--colour-white);
    font-family: var(--font-secondary);
    font-size: 2rem;
    line-height: 1.6;
    margin: 0;
  }

  .secondary-image {
    display: flex;
    align-items: flex-end;
  }

  .secondary-image img{
    width: 22rem;
    height: 22rem;
    object-fit: cover;
    border-radius: 50%;
    border: var(--border-px) solid var(--colour-white);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    margin: 0;
  }

  .read-more-about {
    width: 15rem;
    height: 4rem;
    background-color: var(--colour-dark);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--colour-white);
    text-decoration: none;
    font-family: var(--font-secondary);
    margin-top: 1rem;
    font-size: 1.6rem;
    transition: all 0.1s ease-in-out;

    &:hover{
      filter: brightness(0.9);
    }
  }

  /* --- SECTION 3: NAVIGATION CONFIG --- */
  .nav-section {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .nav-images-container {
    display: flex;
    flex-direction: row;
    flex: 1;
    height: 100%;
  }

  .nav-image-wrapper {
    position: relative;
    width: 50%;
    height: 100%;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-decoration: none;
  }

  .nav-image-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  .nav-image-wrapper::after{
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    backdrop-filter: blur(8px);
    background-color: rgba(0, 0, 0, 0.2);
    z-index: 2;

    cursor: pointer;
    transition: backdrop-filter 0.3s ease, background-color 0.3s ease;
  }

  .nav-image-header {
    position: relative;
    z-index: 3;
    color: var(--colour-white);
    font-family: var(--font-primary);
    font-size: 5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
    transition: 0.3s ease;
    text-decoration: none;
  }

  .nav-image-subtext {
    position: relative;
    z-index: 3;
    color: var(--colour-white);
    font-family: var(--font-secondary);
    font-size: 1.8rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5);
    transition: 0.3s ease;
    text-decoration: none;
  }

  .nav-image-wrapper:hover::after {
    background-color: rgba(0, 0, 0, 0);
  }

  .nav-image-wrapper:hover .nav-image-header {
    color: var(--colour-dark);
  }

  .nav-image-wrapper:hover .nav-image-subtext {
    color: var(--colour-dark);
  }

  /* Mobile Styling */
  @media (#{$mobile}) {
    :root {
      --border-px: 8px;
    }

    /* Disable Snap Scrolling */
    .snap-scroll-container {
      height: auto;
      scroll-snap-type: none;
      overflow-y: visible;
    }

    .snap-section {
      height: auto;
      min-height: auto;
      scroll-snap-align: none;
      padding: 0;
    }

    .carousel-section :global(.carousel-slide) {
      height: 55vh;
    }

    .carousel-placeholder {
      height: 55vh;
      .placeholder-overlay h1 { font-size: 2.8rem; }
      .placeholder-overlay p { font-size: 1.3rem; }
    }

    /* Arrange Vertically */
    .about-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2.5rem;
      padding: 4rem 1.5rem;
    }

    .text-container {
      align-self: center;
      order: 0;
    }

    .about-header {
      font-size: 3.5rem;
    }

    .about-body {
      font-size: 1.4rem;
      line-height: 1.5;
    }

    .breeder-image {
      height: auto;
      width: 100%;
      max-width: 350px;
      order: 1;
    }

    .secondary-image {
      display: none;
    }

    .read-more-about {
      margin: 2rem auto;
    }

    /* Arrange Vertically */
    .nav-images-container {
      flex-direction: column;
      height: 65vh;
    }

    .nav-image-wrapper {
      width: 100%;
      height: 50%;
    }

    .nav-image-header {
      font-size: 3.2rem;
    }
  }


</style>