---
// src/pages/admin/adult/add.astro
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Icon from "../../../components/Icon.astro"

import { getCachedData } from "../../../scripts/databaseCache";
import Modal from "../../../components/Modal.astro";
import { ADMIN_SITE_NAME, PUPPY_COLOURS} from "../../../config/siteSettings";

// FORCES the page to rebuild dynamically and tells the browser not to cache it
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

export const prerender = false;

// Param
const { searchParams } = Astro.url;
const isEditMode = searchParams.get("edit") === "true";
const parentID = searchParams.get("id");

const { parents } = await getCachedData();

let existingParent: any = null;

if (isEditMode && parentID) {
    existingParent = parents.find((parent: any) => parent.id === parentID) || null;
}

const pageTitle = isEditMode ? "Edit Parent Profile" : "Add Parent";
const submitButtonLabel = isEditMode ? "Save Changes" : "Add Parent";

const todayDateObj = new Date();
const formattedToday = todayDateObj.toISOString().split("T")[0];

---

<AdminLayout title={`${pageTitle} | ${ADMIN_SITE_NAME}`}>
    <main class="add-parent-view">

        <header class="page-header">
            <p class="title-text">{pageTitle}</p>
        </header>

        <div class="workspace-grid" id="parent-form-context" data-colours={JSON.stringify(PUPPY_COLOURS)}>

            <section class="left-panel">
                <div class="image-uploader" id="upload-dropzone">
                    <Icon name="camera" class="camera-icon" style={existingParent ? "display: none;" : ""}/>
                    <img
                            id="image-preview"
                            src={existingParent ? `/images/adults/${existingParent.image}` : ""}
                            alt="Uploaded Preview"
                            style={existingParent
                                ? "display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0.8rem;"
                                : "display: none; width: 100%; height: 100%; object-fit: cover; border-radius: 0.8rem;"
                            }
                    />

                    <a class="upload-button" style={existingParent ? "display: none;" : ""}>Upload a Photo</a>

                    <input
                            type="file"
                            id="parent-image-file"
                            name="parent-image-file"
                            accept="image/png, image/jpeg, image/webp"
                            style="display: none;"
                            required={!isEditMode}
                    />
                </div>

                <div class="required-helper">
                    <span class="required-hint">
                        <span class="required-accent">*</span>
                        Indicates required field
                    </span>
                </div>
            </section>

            <div class="vertical-separator" aria-hidden="true"/>

            <section class="right-panel">
                <form
                        class="parent-info-form"
                        id="parent-add-form"
                        data-mode={isEditMode ? "edit" : "add"}
                        data-id={parentID || ""}
                        data-edit-mode={isEditMode.toString()}
                        data-existing-colour={existingParent?.colour || ""}
                >

                    <div class="form-row-full">
                        <div class="field-group">
                            <label for="parent-name">Parent Name: <span class="required-accent">*</span></label>
                            <input
                                    type="text"
                                    id="parent-name"
                                    placeholder="Parent Name..."
                                    value={existingParent?.name || ""}
                                    name="parent-name"
                                    required
                            />
                        </div>
                    </div>

                    <div class="form-row-full">
                        <div class="field-group">
                            <label for="parent-bio">Bio: <span class="input-subtext">(If no bio specified, the generic one will be used)</span></label>
                            <textarea
                                    id="parent-bio"
                                    placeholder="Bio..."
                                    name="parent-bio"
                                    rows="3"
                                    maxlength="256"
                            >{existingParent?.bio}</textarea>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="breed-select" class="dropdown-label">Breed: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="breed-select" name="breed" required disabled={isEditMode}>
                                    <option value="" selected={!existingParent}>Choose Breed</option>
                                    <option value="yorkie" selected={existingParent?.breed.toLowerCase() === "yorkie"}>Yorkshire Terrier</option>
                                    <option value="biewer" selected={existingParent?.breed.toLowerCase() === "biewer"}>Biewer Terrier</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="parent-dob">Date of Birth: <span class="required-accent">*</span></label>
                            <input
                                    type="date"
                                    id="parent-dob"
                                    value={existingParent?.dob || formattedToday}
                                    name="parent-dob"
                                    required
                            />
                        </div>

                        <div class="field-group">
                            <label for="parent-for-sale">For Sale: <span class="required-accent">*</span></label>
                            <select id="parent-for-sale" name="forSale" required>
                                <option value="true" selected={existingParent?.forSale === true}>Yes</option>
                                <option value="false" selected={existingParent ? existingParent.forSale === false : true}>No</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="colour-select" class="dropdown-label">Colour: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="colour-select" name="colour" required disabled>
                                    <option value="">Choose a breed first...</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="gender-select" class="dropdown-label">Gender: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="gender-select" name="gender" required disabled={isEditMode}>
                                    <option value="" selected={!existingParent}>Choose Gender</option>
                                    <option value="female" selected={existingParent?.gender.toLowerCase() === "female"}>Female</option>
                                    <option value="male" selected={existingParent?.gender.toLowerCase() === "male"}>Male</option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="parent-ref">Reference No: <span class="input-subtext">(Kennel Club Number)</span></label>
                            <input
                                    type="text"
                                    id="parent-ref"
                                    placeholder="Parent Reference..."
                                    value={existingParent?.regID && existingParent.regID !== "#0000" ? existingParent.regID : ""}
                                    name="parent-ref"
                                    maxlength="16"
                            />
                        </div>

                        <div class="field-group id-field-group">
                            <label for="parent-id">System ID: <span class="input-subtext">(Autogenerated)</span></label>
                            <input
                                    type="text"
                                    id="parent-id"
                                    value={existingParent?.id || "..."}
                                    name="parent-id"
                                    disabled
                                    readonly
                            />
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="button" class="discard-btn" id="discard-trigger-btn">Discard Changes</button>
                        <button type="submit" class="submit-btn">{submitButtonLabel}</button>
                    </div>

                </form>
            </section>
        </div>

    </main>

    <Modal id="discard-confirm-modal" header="Are you sure?">
        <div class="modal-form-wrapper">
            <p class="modal-sub-text">Any unsaved changes made to this parent profile configuration will be lost permanently.</p>
            <div class="modal-actions">
                <button type="button" class="modal-btn cancel" data-modal-close>No, Stay</button>
                <button type="button" class="modal-btn save" id="confirm-discard-btn">Yes, Discard</button>
            </div>
        </div>
    </Modal>

</AdminLayout>

<style lang="scss">
    /* GLobal Layout */
    .add-parent-view {
      max-width: 110rem;
      margin: 0 auto;
      padding: 2.5rem;
      box-sizing: border-box;
    }

    /* Header */
    .page-header {
      width: 100%;
      margin-bottom: 2.5rem;
      border-bottom: 1.5px solid var(--colour-dark);
      padding-bottom: 1rem;
    }

    .title-text {
      font-family: var(--font-primary);
      font-size: 2.6rem;
      font-weight: 800;
      color: var(--colour-dark);
      margin: 0;
    }

    /* Workspace Grid */
    .workspace-grid {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      gap: 2.5rem;
    }

    /* Photo Upload */
    .left-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 25%;
      min-width: 20rem;
    }

    .image-uploader {
      width: 100%;
      aspect-ratio: 1 / 1;
      background-color: rgba(0, 0, 0, 0.05);
      border: 2px dashed var(--colour-dark);
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      padding: 1.5rem;
      box-sizing: border-box;
      transition: background-color 0.2s ease, border-color 0.2s ease;
      margin-bottom: 1.5rem;

      &:hover {
        background-color: rgba(0, 0, 0, 0.08);
        .camera-icon {
          transform: scale(1.05);
        }
      }
    }

    .camera-icon {
      width: 3.5rem;
      height: 3.5rem;
      color: var(--colour-dark);
      margin-bottom: 0.8rem;
      transition: transform 0.2s ease
    }

    .upload-button {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--colour-white);
      text-decoration: none;
      background-color: var(--colour-dark);
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      text-align: center;
    }

    /* Required Helper */
    .required-hint {
      font-family: var(--font-primary);
      color: var(--colour-dark);
      font-weight: 700;
      font-size: 1.2rem;
    }

    /* Divider */
    .vertical-separator {
      width: 1.5px;
      background-color: rgba(0, 0, 0, 0.15);
      align-self: stretch;
      min-height: 48rem;
    }

    /* parent Form */
    .right-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .parent-info-form {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 1.2rem;
    }

    /* Row Layout */
    .form-row-full {
      width: 100%;
    }

    .form-row-split {
      display: flex;
      flex-direction: row;
      width: 100%;
      gap: 1.5rem;

      .field-group {
        flex: 1;
      }

      .element-spacer {
        visibility: hidden
      }
    }

    /* Form Inputs */
    .field-group {
      display: flex;
      flex-direction: column;

      label {
        font-family: var(--font-primary);
        font-weight: 800;
        font-size: 1.3rem;
        color: var(--colour-dark);
        margin-bottom: 0.4rem;
      }

      .input-subtext {
        font-style: italic;
        font-weight: 400;
        font-size: 0.8rem;
        font-family: var(--font-secondary);
      }

      input[type="text"],
      input[type="date"],
      textarea,
      select {
        font-family: var(--font-secondary);
        background-color: rgba(0, 0, 0, 0.07);
        color: var(--colour-white);
        font-size: 1.2rem;
        padding: 0.7rem 0.9rem;
        border: 1.5px solid var(--colour-dark);
        border-radius: 0.6rem;
        outline: none;
        box-sizing: border-box;
        width: 100%;
        transition: background-color 0.2s ease, border-color 0.2s ease;

        &::placeholder {
          color: var(--colour-white);
          font-style:  italic;
        }

        &:focus {
          background-color: rgba(0, 0, 0, 0.11);
        }
      }

      textarea {
        resize: none;
      }
    }

    input:disabled,
    textarea:disabled,
    select:disabled {
      cursor: not-allowed !important;
      background-color: rgba(0, 0, 0, 0.03) !important;
      color: var(--colour-dark) !important;
      opacity: 0.5 !important;
      user-select: none;
    }

    .id-field-group {
      input[disabled] {
        font-family: var(--font-secondary);
        background-color: rgba(0, 0, 0, 0.03);
        color: var(--colour-dark);
        font-size: 1.2rem;
        padding: 0.7rem 0.9rem;
        border: 1.5px dashed var(--colour-dark);
        border-radius: 0.6rem;
        outline: none;
        box-sizing: border-box;
        width: 100%;
        transition: background-color 0.2s ease, border-color 0.2s ease;

        &::placeholder {
          color: var(--colour-white);
          font-style:  italic;
        }
      }
    }

    .required-accent {
      color: indianred;
    }

    /* Dropdowns */
    .select-wrapper {
      position: relative;
      width: 100%;

      select {
        appearance: none;
        -webkit-appearance: none;
        padding-right: 2.5rem !important;
        cursor: pointer;
      }

      &::after {
        content: "▼";
        font-size: 0.8rem;
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--colour-dark);
        pointer-events: none;
      }
    }

    /* Buttons */
    .action-buttons {
      display: flex;
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
      gap: 1.2rem;
      margin-top: 1.5rem;
      border-top: 1.5px solid rgba(0, 0, 0, 0.08);
      padding-top: 1.5rem;
      width: 100%;
    }

    .discard-btn, .submit-btn {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 700;
      padding: 0.7rem 1.6rem;
      border-radius: 0.6rem;
      cursor: pointer;
      box-sizing: border-box;
      transition: transform 0.1s ease, filter 0.2s ease;

      &:active {
        transform: scale(0.98);
      }
    }

    .discard-btn {
      background-color: transparent;
      border: 1.5px solid var(--colour-dark);
      color: var(--colour-dark);

      &:hover {
        background-color: rgba(0, 0, 0, 0.05);
      }
    }

    .submit-btn {
      background-color: var(--colour-dark);
      border: none;
      color: var(--colour-white);

      &:hover {
        filter: brightness(1.06);
      }
    }

    /* Modal */
    .modal-form-wrapper {
      font-family: var(--font-secondary);
      padding: 0.5rem 0;
      .modal-sub-text {
        font-size: 1.3rem;
        color: #475569;
        margin: 0 0 2rem 0;
        line-height: 1.5;
      }
    }
    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 1rem;
    }
    .modal-btn {
      padding: 0.8rem 1.8rem;
      font-size: 1.3rem;
      font-weight: 700;
      border-radius: 0.6rem;
      border: none;
      cursor: pointer;
      transition: transform 0.1s ease, filter 0.2s ease;
      &:active { transform: scale(0.98); }
    }
    .modal-btn.cancel {
      background: var(--colour-white);
      color: var(--colour-dark);
      &:hover { background: var(--colour-light); }
    }
    .modal-btn.save {
      background: var(--colour-dark);
      color: white;
      &:hover { filter: brightness(1.1); }
    }

    /* Mobile Styling */
    @media (#{$mobile}) {
      .add-puppy-view {
        padding: 1.5rem 1rem 4rem 1rem;
      }

      .page-header {
        margin-bottom: 1.5rem;
      }

      .title-text {
        font-size: 2.2rem;
      }

      .workspace-grid {
        flex-direction: column;
        align-items: center;
        gap: 2rem;
      }

      .left-panel {
        width: 100%;
        max-width: 28rem;
      }

      .vertical-separator {
        display: none;
      }

      .form-row-split {
        flex-direction: column;
        gap: 1.2rem;
      }

      .field-group {
        input[type="text"],
        input[type="date"],
        textarea,
        select {
          font-size: 1.6rem;
          padding: 0.9rem 1rem;
        }

        input[type="date"] {
          max-width: 20rem;
        }
      }

      .action-buttons {
        flex-direction: column-reverse;
        gap: 1rem;
        margin-top: 2rem;

        .discard-btn, .submit-btn {
          width: 100%;
          padding: 1rem;
          font-size: 1.4rem;
          text-align: center;
        }
      }

      .modal-actions {
        flex-direction: column-reverse;
        gap: 0.8rem;

        .modal-btn {
          width: 100%;
          text-align: center;
          padding: 1rem;
        }
      }
    }
</style>

<script>
    import "../../../scripts/admin/adultFormController.ts";
</script>