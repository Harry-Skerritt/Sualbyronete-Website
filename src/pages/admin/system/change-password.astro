---
// src/pages/admin/system/change-password.astro

import AdminLayout from "../../../layouts/AdminLayout.astro"
import { ADMIN_SITE_NAME } from "../../../config/siteSettings";
import { getDB } from "../../../db";
import { adminUsers } from "../../../db/schema";
import { eq } from "drizzle-orm";

export const prerender = false;

const { searchParams } = Astro.url;
const fromDashboard = searchParams.get("from") === "dashboard";
const token = searchParams.get("token");

let isTokenReset = false;
let autofilledUserEmail = "";

if (token) {
    const db = await getDB();

    // Get the token from the db
    const users = await db.select()
        .from(adminUsers)
        .where(eq(adminUsers.resetTokenHash, token))
        .limit(1);

    const user = users[0];

    // Check token isnt expired
    if (user && user.resetTokenExpires && user.resetTokenExpires > Date.now()) {
        isTokenReset = true;
        autofilledUserEmail = user.email;
    } else {
        return Astro.redirect('admin?error=invalid-token');
    }
}
---

<AdminLayout title={`Change Password | ${ADMIN_SITE_NAME}`}>

    <div class="main-container">

        <header class="admin-header">
            <div class="header-text">
                <h1>{isTokenReset ? "Reset Admin Password" : "Change Admin Password"}</h1>
                <p>{isTokenReset ? "Create a new secure password for your account" : "Update your account password below"}</p>
            </div>
        </header>

        <div class="security-card-wrapper">
            <div class="card-header">
                <h2>{isTokenReset ? "Reset Account Credentials" : "Update Password"}</h2>
                <p>{isTokenReset ? "Fill in your new credentials to gain access" : "Verify credentials to change password"}</p>
            </div>

            <div id="page-error-banner" class="status-banner error" style="display: none;"></div>
            <div id="page-success-banner" class="status-banner success" style="display: none;">
                Password changed successfully! Redirecting...
            </div>

            <form
                    id="change-password-form"
                    class="security-form"
                    data-from-dashboard={fromDashboard.toString()}
                    data-token={token || ""}
            >
                <div class="form-group">
                    <label for="pwd-identifier">Username or Email:</label>
                    <input
                            type="text"
                            id="pwd-identifier"
                            required
                            placeholder="Enter username or emailo"
                            value={autofilledUserEmail}
                            readonly={isTokenReset}
                            class={isTokenReset ? "locked-field" : ""}
                    />
                </div>

                {!isTokenReset && (
                        <div class="form-group">
                            <label for="pwd-current">Current Password</label>
                            <input type="password" id="pwd-current" required placeholder="••••••••" />
                        </div>
                )}

                <div class="form-group">
                    <label for="pwd-new">New Password</label>
                    <input type="password" id="pwd-new" required placeholder="••••••••" />
                </div>

                <ul class="password-requirements" id="password-requirements-list">
                    <li data-requirement="length">8 to 32 characters long</li>
                    <li data-requirement="uppercase">At least one uppercase letter (A-Z)</li>
                    <li data-requirement="lowercase">At least one lowercase letter (a-z)</li>
                    <li data-requirement="number">At least one numerical digit (0-9)</li>
                    <li data-requirement="special">At least one special character (!@#$%^&*)</li>
                </ul>

                <div class="form-group">
                    <label for="pwd-confirm">Retype Password</label>
                    <input type="password" id="pwd-confirm" required placeholder="••••••••" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">
                        {isTokenReset ? "Save New Password" : "Update Password"}
                    </button>
                </div>
            </form>
        </div>

    </div>

</AdminLayout>

<style lang="scss">
  .main-container {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
    min-height: calc(100vh - var(--header-height));
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--colour-light);
    gap: 2rem;

    .header-text {
      h1 {
        font-family: var(--font-primary);
        font-size: 2.5rem;
        color: var(--colour-dark);
        margin: 0 0 0.5rem 0;
      }
      p {
        font-family: var(--font-secondary);
        font-size: 1.1rem;
        color: var(--colour-light);
        margin: 0;
      }
    }
  }

  .security-card-wrapper {
    background-color: var(--colour-dark);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);

    .card-header {
      margin-bottom: 1.5rem;
      h2 {
        font-family: var(--font-primary);
        font-size: 1.4rem;
        color: var(--colour-white);
        margin: 0 0 0.35rem 0;
      }
      p {
        font-family: var(--font-secondary);
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
      }
    }
  }

  .status-banner {
    padding: 0.85rem 1rem;
    border-radius: 6px;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    font-weight: 500;

    &.error {
      background-color: rgba(239, 68, 68, 0.15);
      border: 1px solid #ef4444;
      color: #f87e7e;
    }

    &.success {
      background-color: rgba(34, 197, 94, 0.15);
      border: 1px solid #22c55e;
      color: #86efac;
    }
  }

  .security-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      label {
        font-family: var(--font-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--colour-white);
      }

      input {
        height: 2.8rem;
        border-radius: 6px;
        padding: 0 0.8rem;
        border: 2px solid rgba(255, 255, 255, 0.15);
        background-color: rgba(255, 255, 255, 0.05);
        color: var(--colour-white);
        font-family: var(--font-secondary);
        font-size: 1rem;
        outline: none;
        transition: all 0.15s ease-in-out;

        &::placeholder {
          color: rgba(255, 255, 255, 0.3);
        }

        &:focus {
          border-color: var(--colour-light);
          background-color: rgba(255, 255, 255, 0.08);
          box-shadow: 0 0 8px rgba(255, 255, 255, 0.05);
        }
      }
    }
  }

  .password-requirements {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;

    li {
      font-family: var(--font-secondary);
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.4);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.15s ease;

      // Bullet indicator circle
      &::before {
        content: '•';
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.3);
      }

      &.valid {
        color: #86efac;
        font-weight: 500;

        &::before {
          content: '✓';
          font-size: 0.85rem;
          color: #22c55e;
        }
      }
    }
  }

  .form-actions {
    margin-top: 0.5rem;
  }

  .btn-submit {
    width: 100%;
    font-family: var(--font-secondary);
    font-size: 1rem;
    font-weight: 600;
    color: var(--colour-dark);
    background-color: var(--colour-white);
    border: none;
    padding: 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;

    &:hover {
      background-color: var(--colour-light);
      transform: translateY(-1px);
    }

    &:active {
      transform: translateY(1px);
    }
  }

  input.locked-field {
    background-color: rgba(255, 255, 255, 0.02) !important;
    border-style: dotted !important;
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>

<script>
    function initPasswordPageEditor() {
        const form = document.getElementById("change-password-form") as HTMLFormElement;
        const errBanner = document.getElementById("page-error-banner");
        const successBanner = document.getElementById("page-success-banner");
        const newPwdInput = document.getElementById("pwd-new") as HTMLInputElement;
        const reqList = document.getElementById("password-requirements-list");

        if (!form) return;

        // Req Tracker
        if (newPwdInput && reqList) {
            newPwdInput.addEventListener("input", e => {
                const value = newPwdInput.value;

                const checks = {
                    length: value.length >= 8 && value.length <= 32,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[!@#$%^&*()_+\-=\[\]{};':",\\|.<>\/?]/.test(value)
                };

                Object.entries(checks).forEach(([requirement, isValid]) => {
                    const el = reqList.querySelector(`[data-requirement="${requirement}"]`);
                    if (el) {
                        if (isValid) {
                            el.classList.add('valid');
                        } else {
                            el.classList.remove('valid');
                        }
                    }
                });
            });
        }

        // Check Creds and update db
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (errBanner) errBanner.style.display = "none";
            if (successBanner) successBanner.style.display = "none";

            const identifier = (document.getElementById("pwd-identifier") as HTMLInputElement).value;
            const newPassword = (document.getElementById("pwd-new") as HTMLInputElement).value;
            const confirmPassword = (document.getElementById("pwd-confirm") as HTMLInputElement).value;

            const currentPwdEl = document.getElementById("pwd-current") as HTMLInputElement | null;
            const currentPassword = currentPwdEl ? currentPwdEl.value : "";

            const token = form.dataset.token || "";

            try {
                // Server side injection guard
                const hasUppercase = /[A-Z]/.test(newPassword);
                const hasLowercase = /[a-z]/.test(newPassword);
                const hasNumber = /[0-9]/.test(newPassword);
                const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':",\\|.<>\/?]/.test(newPassword);
                const isValidLength = newPassword.length >= 8 && newPassword.length <= 32;

                if (!isValidLength || !hasUppercase || !hasLowercase || !hasNumber || !hasSpecial) {
                    throw new Error("Password does not meet all the security requirements listed below");
                }

                if (newPassword !== confirmPassword) {
                    throw new Error("New passwords do not match. Please retype them");
                }

                const response = await fetch('/admin/auth/change-password-submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier, currentPassword, newPassword, token })
                });

                const data = await response.json() as { success: boolean; message?: string };

                if (response.ok && data.success) {
                    if (successBanner) successBanner.style.display = "block";
                    form.reset();
                    reqList?.querySelectorAll('li').forEach(li => li.classList.remove('valid'));

                    const redirectFromDashboard = form.dataset.fromDashboard === "true";

                    setTimeout(() => {
                        if (token) {
                            window.location.href = '/admin';
                        } else if (redirectFromDashboard) {
                            window.location.href = '/admin/dashboard';
                        } else {
                            window.location.href = '/admin';
                        }
                    }, 1000);
                } else {
                    throw new Error(data.message || "Failed Credential Confirmation");
                }
            } catch (err: any) {
                if (errBanner) {
                    errBanner.textContent = err.message;
                    errBanner.style.display = "block";
                }
            }
        });
    }

    initPasswordPageEditor();
    document.addEventListener('astro:page-load', initPasswordPageEditor);
</script>