---
// src/pages/admin/dashboard.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminEditButton from "../../components/admin/AdminEditButton.astro";
import DataCounter from "../../components/admin/DataCounter.astro";
import Modal from "../../components/Modal.astro";
import { getCachedData } from "../../scripts/databaseCache";
import {ADMIN_SITE_NAME, SITE_NAME} from "../../config/siteSettings";

// Name from Cookie
const nameCookie = Astro.cookies.get('admin_user_name');
const currentAdminName = nameCookie ? nameCookie.value : "Admin User";

// DB
export const prerender = false;

const { allPuppies, parents } = await getCachedData();

const totalPuppies = allPuppies.length;
const totalParents = parents.length;
---

<AdminLayout title=`${ADMIN_SITE_NAME} | ${SITE_NAME}`>

    <main class="dashboard-container">

        <header class="welcome-header">
            <p class="welcome-message">Hello {currentAdminName}</p>
            <div class="horizontal-separator"/>
        </header>

        <section class="latest-puppies-section">
            <p class="section-title">Latest Puppies:</p>
            <div class="latest-puppy-row">
                <!-- Show the 3 latest puppies here -->
                <div class="placeholder-card">Puppy Slot 1</div>
                <div class="placeholder-card">Puppy Slot 2</div>
                <div class="placeholder-card">Puppy Slot 3</div>
            </div>
        </section>

        <section class="data-viewer">

            <section class="left-data">
                <!--- Puppy Counter -->
                <DataCounter id="puppy-counter" title="Current Puppy Count" data={totalPuppies}/>

                <div class="button-row">
                    <AdminEditButton id="puppy-add-btn" icon="add" text="Add Puppy"/>
                    <AdminEditButton id="puppy-edit-btn" icon="edit" text="Edit Puppies"/>
                </div>

            </section>

            <section class="right-data">
                <!-- Adult Counter -->
                <DataCounter id="adult-counter" title="Current Parent Count" data={totalParents}/>


                <div class="button-row">
                    <AdminEditButton id="adult-add-btn" icon="add" text="Add Parent"/>
                    <AdminEditButton id="adult-edit-btn" icon="edit" text="Edit Parents"/>
                </div>

            </section>

        </section>

        <section class="generic-edit-section">
            <!-- Edit Buttons -->
            <AdminEditButton id="photo-edit-btn" icon="edit" text="Edit Home Page Photos"/>
            <AdminEditButton id="bio-edit-btn" icon="edit" text="Edit Default Puppy Bios"/>
            <AdminEditButton id="puppy-pack-edit-btn" icon="edit" text="Edit Puppy Pack Info"/>
            <AdminEditButton id="open-password-modal-btn" icon="edit" text="Change Admin Password"/>
        </section>

    </main>

    <Modal id="password-change-modal" header="Change Password">
        <div class="modal-form-wrapper">
            <p class="modal-sub">Verify identity credentials to overwrite database token entries.</p>

            <div id="modal-error-banner" class="modal-error"></div>
            <div id="modal-success-banner" class="modal-success">Password changed successfully!</div>

            <form id="change-password-form">
                <div class="form-group">
                    <label for="pwd-identifier">Username or Email Address</label>
                    <input type="text" id="pwd-identifier" required placeholder="Username" />
                </div>
                <div class="form-group">
                    <label for="pwd-current">Current Password</label>
                    <input type="password" id="pwd-current" required />
                </div>
                <div class="form-group">
                    <label for="pwd-new">New Password</label>
                    <input type="password" id="pwd-new" required />
                </div>

                <div class="modal-actions">
                    <button type="button" class="modal-btn cancel" data-modal-close>Cancel</button>
                    <button type="submit" class="modal-btn save">Update Password</button>
                </div>
            </form>
        </div>
    </Modal>
</AdminLayout>

<style lang="scss">
  .dashboard-container {
    max-width: 110rem;
    margin: 2rem auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    box-sizing: border-box;
  }

  /* Header */
  .welcome-header {
    .welcome-message {
      font-family: var(--font-primary);
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--colour-dark);
      margin: 0 0 0.5rem 0;
    }
    .horizontal-separator {
      width: 100%;
      height: 4px;
      background-color: var(--colour-dark);
      border-radius: 2px;
    }
  }

  /* Latest Puppies */
  .latest-puppies-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .section-title {
      font-family: var(--font-secondary);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--colour-dark);
      margin: 0;
    }

    .latest-puppy-row {
      display: flex;
      flex-direction: row;
      gap: 1.5rem;
      width: 100%;

      // Temporary placeholder card
      .placeholder-card {
        flex: 1;
        height: 7rem;
        background: #e2e8f0;
        border: 3px dashed #cbd5e1;
        border-radius: 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-family: var(--font-secondary);
      }
    }
  }

  /* Metrics */
  .data-viewer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    width: 100%;

    .data-column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .button-row {
      display: flex;
      flex-direction: row;
      gap: 1rem;

      :global(.button-container) {
        flex: 1;
        width: 100%;
      }
    }

    :global(.counter-container) {
      flex: 1;
      width: 100%;
      height: 10rem;
      margin-bottom: 1rem;
    }
  }


  /* Edit Buttons */
  .generic-edit-section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 2px solid rgba(0, 0, 0, 0.1);

    :global(.button-container) {
      width: calc(33.333% - 0.666rem);
      min-width: 18rem;
    }
  }

  /* Modal */
  .modal-form-wrapper {
    font-family: var(--font-secondary);
    padding-bottom: 1rem;

    .modal-sub {
      font-size: 1.2rem;
      color: #64748b;
      margin: 0 0 1.5rem 0;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;

    label {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--colour-dark);
    }
    input {
      padding: 1rem;
      font-size: 1.4rem;
      border: 2px solid var(--colour-dark);
      border-radius: 0.6rem;
      outline: none;
      background-color: var(--colour-white);
      &:focus {
        border-color: var(--colour-dark);
      }
    }
  }

  .modal-error {
    display: none;
    background: #fef2f2;
    border: 1.5px solid #f87171;
    color: #991b1b;
    padding: 1rem;
    border-radius: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .modal-success {
    display: none;
    background: #f0fdf4;
    border: 1.5px solid #4ade80;
    color: #166534;
    padding: 1rem;
    border-radius: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
  }

  .modal-btn {
    padding: 1rem 2rem;
    font-size: 1.3rem;
    font-weight: 600;
    border-radius: 0.6rem;
    border: none;
    cursor: pointer;
    transition: transform 0.1s ease;
    &:active { transform: scale(0.98); }
  }

  .modal-btn.cancel {
    background: #e2e8f0;
    color: #475569;
    &:hover { background: #cbd5e1; }
  }

  .modal-btn.save {
    background: var(--colour-dark);
    color: white;
    &:hover { filter: brightness(1.1); }
  }

  /* Mobile Styling */
  @media ($mobile) {
    .dashboard-container {
      padding: 0 1.5rem;
      gap: 2.5rem;
      margin: 1rem auto
    }

    .welcome-header .welcome-message {
      font-size: 2rem;
    }

    .latest-puppies-section .latest-puppy-row {
      flex-direction: column;
      gap: 1rem;

      .placeholder-card {
        height: 5.5rem;
      }
    }

    .data-viewer {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .generic-edit-section {
      flex-direction: column;

      :global(.button-container) {
        width: 100% !important;
      }
    }

    .modal-actions {
      flex-direction: column-reverse;
      width: 100%;

      .modal-btn {
        width: 100%;
        text-align: center;
        padding: 1.2rem;
      }
    }
  }
</style>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        /* Puppy Buttons */
        const puppyAddBtn = document.getElementById("puppy-add-btn");
        if (puppyAddBtn) {
            puppyAddBtn.addEventListener("click", () => {
                window.location.href = "/puppy/add";
            })
        }

        const puppyEditBtn = document.getElementById("puppy-edit-btn");
        if (puppyEditBtn) {
            puppyEditBtn.addEventListener("click", () => {
                const targetURL = new URL("/edit", window.location.origin);
                targetURL.searchParams.set('type', 'puppies');
                window.location.href = targetURL.toString();
            })
        }

        /* Adult Buttons */
        const adultAddBtn = document.getElementById("adult-add-btn");
        if (adultAddBtn) {
            adultAddBtn.addEventListener("click", () => {
                window.location.href = "/adult/add";
            })
        }

        const adultEditBtn = document.getElementById("adult-edit-btn");
        if (adultEditBtn) {
            adultEditBtn.addEventListener("click", () => {
                const targetURL = new URL("/edit", window.location.origin);
                targetURL.searchParams.set('type', 'adults');
                window.location.href = targetURL.toString();
            })
        }

        /* Home Page Photos */
        const homeEditBtn = document.getElementById("photo-edit-btn");
        if (homeEditBtn) {
            homeEditBtn.addEventListener("click", () => {
                window.location.href = "/photoEdit";
            })
            }

        /* Password */
        const modalEl = document.getElementById("password-change-modal");
        const openModalBtn = document.getElementById("open-password-modal-btn");
        const form = document.getElementById("change-password-form") as HTMLFormElement;
        const errBanner = document.getElementById("modal-error-banner");
        const successBanner = document.getElementById("modal-success-banner");

        openModalBtn?.addEventListener("click", () => {
            if (modalEl) {
                modalEl.classList.add("is-active");
                modalEl.removeAttribute("aria-hidden");
            }
        });

        const hideModalAndReset = () => {
            if (modalEl) {
                modalEl.classList.remove("is-active");
                modalEl.setAttribute("aria-hidden", "true");
            }
            if (form) form.reset();
            if (errBanner) errBanner.style.display = "none";
            if (successBanner) successBanner.style.display = "none";
        };

        modalEl?.querySelectorAll('[data-modal-close]').forEach(btn => {
            btn.addEventListener('click', hideModalAndReset);
        });

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (errBanner) errBanner.style.display = "none";
            if (successBanner) successBanner.style.display = "none";

            const identifier = (document.getElementById("pwd-identifier") as HTMLInputElement).value;
            const currentPassword = (document.getElementById("pwd-current") as HTMLInputElement).value;
            const newPassword = (document.getElementById("pwd-new") as HTMLInputElement).value;

            try {
                const response = await fetch('/admin/auth/change-password-submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identifier, currentPassword, newPassword })
                });

                const data = await response.json() as { success: boolean; message?: string };

                if (response.ok && data.success) {
                    if (successBanner) successBanner.style.display = "block";
                    form.reset();
                    // Smooth exit sequence execution
                    setTimeout(hideModalAndReset, 1500);
                } else {
                    throw new Error(data.message || "Credential matching execution verified incorrect status");
                }

            } catch (err: any) {
                if (errBanner) {
                    errBanner.textContent = err.message;
                    errBanner.style.display = "block";
                }
            }
        });
    });
</script>