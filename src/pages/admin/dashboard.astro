---
// src/pages/admin/dashboard.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminEditButton from "../../components/admin/AdminEditButton.astro";
import DataCounter from "../../components/admin/DataCounter.astro";
import Modal from "../../components/Modal.astro";
import { getCachedData } from "../../scripts/databaseCache";
import {ADMIN_SITE_NAME, mediaURL, SITE_NAME} from "../../config/siteSettings";
import RecentPuppyCard from "../../components/admin/RecentPuppyCard.astro";
import {formatGender} from "../../config/puppyConstants";

// FORCES the page to rebuild dynamically and tells the browser not to cache it
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

// Name from Cookie
const nameCookie = Astro.cookies.get('admin_user_name');
const currentAdminName = nameCookie ? nameCookie.value : "Admin User";

// DB
export const prerender = false;

const { allPuppies, parents } = await getCachedData();

const totalPuppies = allPuppies.length;
const totalParents = parents.length;

const latestPuppies = [...allPuppies]
    .sort((a,b) => b.seqID - a.seqID)
    .slice(0, 3);


---

<AdminLayout title=`${ADMIN_SITE_NAME} | ${SITE_NAME}`>

    <main class="dashboard-container">

        <header class="welcome-header">
            <p class="welcome-message">Hello {currentAdminName}</p>
            <div class="horizontal-separator"/>
        </header>

        <section class="latest-puppies-section">
            <p class="section-title">Latest Puppies:</p>
            <div class="latest-puppy-row">
                {latestPuppies.map((pup:any) => (
                    <RecentPuppyCard
                            puppyName={pup.name}
                            puppyAddDate={pup.dateAdded}
                            puppyID={pup.id}
                            puppyImage={`${mediaURL}/images/puppies/${pup.image}`}
                            puppyBreed={pup.breed}
                            puppyGender={pup.gender}
                            type="puppy"
                    />
                ))}

                {latestPuppies.length === 0 && (
                        <div class="placeholder-card">No puppy profiles found in the database.</div>
                )}
            </div>
        </section>

        <section class="data-viewer">

            <section class="left-data">
                <!--- Puppy Counter -->
                <DataCounter id="puppy-counter" title="Current Puppy Count" data={totalPuppies}/>

                <div class="button-row">
                    <AdminEditButton id="puppy-add-btn" icon="add" text="Add Puppy"/>
                    <AdminEditButton id="puppy-edit-btn" icon="edit" text="Edit Puppies"/>
                </div>

            </section>

            <section class="right-data">
                <!-- Adult Counter -->
                <DataCounter id="adult-counter" title="Current Parent Count" data={totalParents}/>


                <div class="button-row">
                    <AdminEditButton id="adult-add-btn" icon="add" text="Add Parent"/>
                    <AdminEditButton id="adult-edit-btn" icon="edit" text="Edit Parents"/>
                </div>

            </section>

        </section>

        <section class="generic-edit-section">
            <!-- Edit Buttons -->
            <AdminEditButton id="photo-edit-btn" icon="edit" text="Edit Home Page Photos"/>
            <AdminEditButton id="bio-edit-btn" icon="edit" text="Edit Default Puppy Bios"/>
            <AdminEditButton id="puppy-pack-edit-btn" icon="edit" text="Edit Puppy Pack Info"/>
            <AdminEditButton id="change-password-btn" icon="edit" text="Change Admin Password"/>
        </section>

    </main>

    <Modal id="delete-confirm-modal" header="Delete Profile?">
        <div class="modal-form-wrapper">
            <p class="modal-sub-text">Are you sure you want to delete <strong id="modal-dog-target-name">this entry</strong>?<br /> This action will permanently wipe their data records and images from the database</p>
            <div class="modal-actions">
                <button type="button" class="modal-btn cancel" data-modal-close>No, Cancel</button>
                <button type="button" class="modal-btn save delete-confirm-btn" id="confirm-delete-action">Yes, Delete</button>
            </div>
        </div>
    </Modal>
</AdminLayout>

<style lang="scss">
  .dashboard-container {
    max-width: 110rem;
    margin: 2rem auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    box-sizing: border-box;
    min-height: calc(100vh - var(--header-height));
  }

  /* Header */
  .welcome-header {
    .welcome-message {
      font-family: var(--font-primary);
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--colour-dark);
      margin: 0 0 0.5rem 0;
    }
    .horizontal-separator {
      width: 100%;
      height: 4px;
      background-color: var(--colour-dark);
      border-radius: 2px;
    }
  }

  /* Latest Puppies */
  .latest-puppies-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .section-title {
      font-family: var(--font-secondary);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--colour-dark);
      margin: 0;
    }

    .latest-puppy-row {
      display: flex;
      flex-direction: row;
      gap: 1.5rem;
      width: 100%;
    }
  }


  /* Metrics */
  .data-viewer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    width: 100%;

    .data-column {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .button-row {
      display: flex;
      flex-direction: row;
      gap: 1rem;

      :global(.button-container) {
        flex: 1;
        width: 100%;
      }
    }

    :global(.counter-container) {
      flex: 1;
      width: 100%;
      height: 10rem;
      margin-bottom: 2rem;
    }
  }


  /* Edit Buttons */
  .generic-edit-section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 2px solid rgba(0, 0, 0, 0.1);

    :global(.button-container) {
      width: calc(33.333% - 0.666rem);
      min-width: 18rem;
    }
  }

  /* Modal */
  .modal-form-wrapper {
    font-family: var(--font-secondary);
    padding-bottom: 1rem;

    .modal-sub {
      font-size: 1.2rem;
      color: #64748b;
      margin: 0 0 1.5rem 0;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;

    label {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--colour-dark);
    }
    input {
      padding: 1rem;
      font-size: 1.4rem;
      border: 2px solid var(--colour-dark);
      border-radius: 0.6rem;
      outline: none;
      background-color: var(--colour-white);
      &:focus {
        border-color: var(--colour-dark);
      }
    }
  }

  .modal-error {
    display: none;
    background: #fef2f2;
    border: 1.5px solid #f87171;
    color: #991b1b;
    padding: 1rem;
    border-radius: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .modal-success {
    display: none;
    background: #f0fdf4;
    border: 1.5px solid #4ade80;
    color: #166534;
    padding: 1rem;
    border-radius: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
  }

  .modal-btn {
    padding: 1rem 2rem;
    font-size: 1.3rem;
    font-weight: 600;
    border-radius: 0.6rem;
    border: none;
    cursor: pointer;
    transition: transform 0.1s ease;
    &:active { transform: scale(0.98); }
  }

  .modal-btn.cancel {
    background: #e2e8f0;
    color: #475569;
    &:hover { background: #cbd5e1; }
  }

  .modal-btn.save {
    background: var(--colour-dark);
    color: white;
    &:hover { filter: brightness(1.1); }
  }

  /* Mobile Styling */
  @media ($mobile) {
    .dashboard-container {
      padding: 0 1.5rem;
      gap: 2.5rem;
      margin: 1rem auto
    }

    .welcome-header .welcome-message {
      font-size: 2rem;
    }

    .latest-puppies-section .latest-puppy-row {
      flex-direction: column;
      gap: 1rem;

      .placeholder-card {
        height: 5.5rem;
      }
    }

    .data-viewer {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .generic-edit-section {
      flex-direction: column;

      :global(.button-container) {
        width: 100% !important;
      }
    }

    .modal-actions {
      flex-direction: column-reverse;
      width: 100%;

      .modal-btn {
        width: 100%;
        text-align: center;
        padding: 1.2rem;
      }
    }
  }
</style>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Tracker Context Variables for Delete Ops
        let targetedCardId: string | null = null;
        let targetedCardType: string | null = null;
        let activeCardElement: HTMLElement | null = null;

        const deleteModal = document.getElementById("delete-confirm-modal");
        const modalTargetNameText = document.getElementById("modal-dog-target-name");
        const confirmDeleteBtn = document.getElementById("confirm-delete-action") as HTMLButtonElement;

        document.addEventListener("dog:delete-intent", (event: Event) => {
            const customEvent = event as CustomEvent;
            const {id, type, name, element} = customEvent.detail;

            if (!deleteModal) return;

            targetedCardId = id;
            targetedCardType = type;
            activeCardElement = element;

            if (modalTargetNameText) {
                modalTargetNameText.innerText = name || "this entry";
            }

            deleteModal.classList.add("is-active");
            deleteModal.removeAttribute("aria-hidden");
        });

        /* Delete Button */
        confirmDeleteBtn?.addEventListener("click", async () => {
            if (!targetedCardId || !targetedCardType || !deleteModal) return;

            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.innerText = "Deleting...";

            try {
                const response = await fetch(`/api/delete-dog`, {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({id: targetedCardId, type: targetedCardType})
                });

                const result = await response.json() as { success: boolean; message?: string };

                if (response.ok && result.success) {
                    if (typeof window.showToast === 'function') {
                        window.showToast("Profile wiped successfully!");
                        window.location.reload();
                    }

                    if (activeCardElement) {
                        activeCardElement.style.transition = "opacity 0.3s ease, transform 0.3s ease";
                        activeCardElement.style.opacity = "0";
                        activeCardElement.style.transform = "scale(0.9)";
                        setTimeout(() => activeCardElement?.remove(), 300);
                    }
                } else {
                    if (typeof window.showToast === 'function') {
                        window.showToast(result.message || "Failed to remove item record", true);
                    }
                }
            } catch (error) {
                console.error(error);
                if (typeof window.showToast === 'function') {
                    window.showToast("Network communications failure", true);
                }
            } finally {
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.innerText = "Yes, Delete";
                deleteModal.classList.remove("is-active");
                deleteModal.setAttribute("aria-hidden", "true");
            }
        });

        /* Delte Modal */
        deleteModal?.querySelectorAll('[data-modal-close]').forEach(btn => {
            btn.addEventListener('click', () => {
                deleteModal.classList.remove("is-active");
                deleteModal.setAttribute("aria-hidden", "true");
                targetedCardId = null;
                targetedCardType = null;
                activeCardElement = null;
            });
        });

        /* Puppy Navigation Handlers */
        document.getElementById("puppy-add-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/puppy/add";
        });
        document.getElementById("puppy-edit-btn")?.addEventListener("click", () => {
            const targetURL = new URL("/admin/edit", window.location.origin);
            targetURL.searchParams.set('type', 'puppies');
            window.location.href = targetURL.toString();
        });

        /* Adult Navigation Handlers */
        document.getElementById("adult-add-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/adult/add";
        });
        document.getElementById("adult-edit-btn")?.addEventListener("click", () => {
            const targetURL = new URL("/admin/edit", window.location.origin);
            targetURL.searchParams.set('type', 'adults');
            window.location.href = targetURL.toString();
        });

        /* Home Page Photos */
        document.getElementById("photo-edit-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/system/edit-photos";
        });

        /* Default Bios */
        document.getElementById("bio-edit-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/system/edit-bios";
        });

        /* Include Lists */
        document.getElementById("puppy-pack-edit-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/system/edit-puppy-pack";
        });

        /* Password Modal Management */
        document.getElementById("change-password-btn")?.addEventListener("click", () => {
            window.location.href = "/admin/system/change-password?from=dashboard";
        });
    });
</script>