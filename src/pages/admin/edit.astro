---
// src/pages/admin/edit.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import DogEditCard from "../../components/admin/DogEditCard.astro";
import Modal from "../../components/Modal.astro"

import { getCachedData } from "../../scripts/databaseCache";
import { getColourLabel, formatGender } from "../../config/puppyConstants";
import {count, desc} from "drizzle-orm";

export const prerender = false;
// Get URL Param
const { searchParams } = Astro.url;
const typeParam = searchParams.get("type")?.toLowerCase().trim() || "puppies";
const isPuppyMode = typeParam === "puppies";

const viewTitle = isPuppyMode ? "Edit Puppies" : "Edit Parents";
const countLabel = isPuppyMode ? "Total Puppies" : "Total Parents";
const dogTypeAttr = isPuppyMode ? "puppy" : "adult";

// DB
const { allPuppies, parents } = await getCachedData();
let itemsList = [];

if (isPuppyMode) {
   itemsList = [...allPuppies]
       .sort((a, b) => b.seqID - a.seqID)
       .map((p: any) => ({
           id: p.id,
           name: p.name,
           image: `/images/puppies/${p.image}`,
           breed: p.breed.toLowerCase(),
           gender: formatGender(p.gender),
           date: p.dateAdded
       }));
} else {
    itemsList = [...parents]
        .sort((a, b) => b.seqID - a.seqID)
        .map((a: any) => ({
            id: a.id,
            name: a.name,
            image: `/images/adults/${a.image}`,
            breed: a.breed.toLowerCase(),
            gender: formatGender(a.gender),
            date: a.dateAdded
        }));
}

const totalCount = itemsList.length;
---

<AdminLayout title={`${viewTitle} | Admin Dashboard`}>
    <main class="edit-container">
        <span class="edit-header">{viewTitle}</span>
        <span class="edit-count">{countLabel}: {totalCount}</span>
        <div class="edit-separator" aria-hidden="true"/>

        <div class="dog-cards">
            {itemsList.map((dog: any) => (
                    <DogEditCard
                            name={dog.name}
                            image={dog.image}
                            breed={dog.breed}
                            gender={dog.gender}
                            addDate={dog.date}
                            dataId={dog.id}
                            type={dogTypeAttr}
                    />
            ))}

            {totalCount === 0 && (
                    <p class="empty-state-text">No data records found in system database storage profiles.</p>
            )}
        </div>
    </main>

    <Modal id="delete-confirm-modal" header="Delete Profile?">
        <div class="modal-form-wrapper">
            <p class="modal-sub-text">Are you sure you want to delete <strong id="modal-dog-target-name">this entry</strong>?<br /> This action will permanently wipe their data records and images from the database</p>
            <div class="modal-actions">
                <button type="button" class="modal-btn cancel" data-modal-close>No, Cancel</button>
                <button type="button" class="modal-btn save delete-confirm-btn" id="confirm-delete-action">Yes, Delete</button>
            </div>
        </div>
    </Modal>


</AdminLayout>


<style lang="scss">
  .edit-container {
    min-height: calc(100vh - var(--header-height));
    max-width: 100rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .edit-header {
    margin-top: 2rem;
    font-size: 4rem;
    font-family: var(--font-primary);
    font-weight: bolder;
    color: var(--colour-dark);
  }

  .edit-count {
    margin: 1rem 0;
    font-family: var(--font-secondary);
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--colour-dark);
  }

  .edit-separator {
    width: 90%;
    height: 0.3rem;
    background-color: var(--colour-dark);
    display: block;
    border-radius: 999px;
  }

  .dog-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    margin-top: 2rem;
    gap: 1.5rem;
    width: 100%;
  }

  /* Modal Styling */
  /* Modal */
  .modal-form-wrapper {
    font-family: var(--font-secondary);
    padding: 0.5rem 0;
    .modal-sub-text {
      font-size: 1.3rem;
      color: #475569;
      margin: 0 0 2rem 0;
      line-height: 1.5;
    }
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }
  .modal-btn {
    padding: 0.8rem 1.8rem;
    font-size: 1.3rem;
    font-weight: 700;
    border-radius: 0.6rem;
    border: none;
    cursor: pointer;
    transition: transform 0.1s ease, filter 0.2s ease;
    &:active { transform: scale(0.98); }
  }
  .modal-btn.cancel {
    background: var(--colour-white);
    color: var(--colour-dark);
    &:hover { background: var(--colour-light); }
  }
  .modal-btn.save {
    background: var(--colour-dark);
    color: white;
    &:hover { filter: brightness(1.1); }
  }
  
  /* Mobile Styling */
  @media (#{$mobile}) {
    .edit-container {
      padding: 0 1.5rem 3rem 1.5rem;
    }

    .edit-header {
      font-size: 2.6rem;
      margin-top: 1.5rem;
    }

    .dog-cards {
      grid-template-columns: 1fr;
      margin-top: 1.5rem;
    }

    .modal-actions {
      @media (max-width: 480px) {
        flex-direction: column-reverse;
        gap: 0.75rem;

        .modal-btn {
          width: 100%;
          text-align: center;
          padding: 1rem;
        }
      }
    }
  }
</style>

<script>
    let targetedCardId: string | null = null;
    let targetedCardType: string | null = null;
    let activeCardElement: HTMLElement | null = null;

    const modal = document.getElementById("delete-confirm-modal");
    const modalTargetNameText = document.getElementById("modal-dog-target-name");
    const confirmDeleteBtn = document.getElementById("confirm-delete-action") as HTMLButtonElement;

    document.addEventListener("click", (event) => {
        const trigger = (event.target as HTMLElement).closest(".delete-trigger");
        if (!trigger || !modal) return;

        const parentCard = trigger.closest(".dog-edit-card") as HTMLElement;
        if (!parentCard) return;

        // Capture targets
        targetedCardId = parentCard.dataset.id || null;
        targetedCardType = parentCard.dataset.type || null;
        activeCardElement = parentCard;

        if (modalTargetNameText) {
            modalTargetNameText.innerText = parentCard.dataset.name || "this entry";
        }

        // Open modal trigger
        modal.classList.add("is-active");
        modal.removeAttribute("aria-hidden");
    });

    document.addEventListener("click", (event) => {
        const trigger = (event.target as HTMLElement).closest(".edit");
        if (!trigger) return;

        const parentCard = trigger.closest(".dog-edit-card") as HTMLElement;
        if (!parentCard) return;

        const dogId = parentCard.dataset.id;
        const dogType = parentCard.dataset.type; // 'puppy' or 'adult'

        if (!dogId || !dogType) return;

        if (dogType === "puppy") {
            window.location.href = `/puppy/add?edit=true&id=${dogId}`;
        } else if (dogType === "adult") {
            window.location.href = `/adult/add?edit=true&id=${dogId}`;
        }
    });

    // Window dismissal clean-up closures
    modal?.querySelectorAll('[data-modal-close]').forEach(closeBtn => {
        closeBtn.addEventListener('click', () => {
            modal.classList.remove("is-active");
            modal.setAttribute("aria-hidden", "true");
            targetedCardId = null;
            targetedCardType = null;
            activeCardElement = null;
        });
    });

    // Process DB Action
    confirmDeleteBtn?.addEventListener("click", async () => {
        if (!targetedCardId || !targetedCardType || !modal) return;

        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.innerText = "Deleting...";

        try {
            const response = await fetch(`/api/delete-dog`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: targetedCardId, type: targetedCardType })
            });

            const result = await response.json() as { success: boolean; message?: string };

            if (response.ok && result.success) {
                window.showToast("Profile wiped successfully!");

                // Remove the targeted item smoothly from grid layout view channel
                if (activeCardElement) {
                    activeCardElement.style.transition = "opacity 0.3s ease, transform 0.3s ease";
                    activeCardElement.style.opacity = "0";
                    activeCardElement.style.transform = "scale(0.9)";
                    setTimeout(() => activeCardElement?.remove(), 300);
                }
            } else {
                window.showToast(result.message || "Failed to remove item record", true);
            }
        } catch (error) {
            console.error(error);
            window.showToast("Network communications failure", true);
        } finally {
            confirmDeleteBtn.disabled = false;
            confirmDeleteBtn.innerText = "Yes, Delete";
            modal.classList.remove("is-active");
            modal.setAttribute("aria-hidden", "true");
        }
    });
</script>