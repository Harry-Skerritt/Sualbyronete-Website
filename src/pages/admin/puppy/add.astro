---
// src/pages/admin/puppy/add.astro
import AdminLayout from "../../../layouts/AdminLayout.astro";

import { Icon } from 'astro-icon/components'

import {PUPPY_COLOURS} from "../../../config/puppyConstants";
---

<AdminLayout title="Add Puppy | Admin Dashboard">
    <main class="add-puppy-view">

        <header class="page-header">
            <p class="title-text">Add Puppy</p>
        </header>

        <div class="workspace-grid">

            <section class="left-panel">
                <div class="image-uploader" id="upload-dropzone">
                    <Icon name="camera" class="camera-icon"/>
                    <img id="image-preview" src="" alt="Uploaded Preview" style="display: none; width: 100%; height: 100%; object-fit: cover; border-radius: 0.8rem;" />
                    <a class="upload-button">Upload a Photo</a>

                    <input
                            type="file"
                            id="pup-image-file"
                            name="pup-image-file"
                            accept="image/png, image/jpeg, image/webp"
                            style="display: none;"
                            required
                    />
                </div>

                <div class="required-helper">
                    <span class="required-hint">
                        <span class="required-accent">*</span>
                        Indicates required field
                    </span>
                </div>
            </section>

            <div class="vertical-separator" aria-hidden="true"/>

            <section class="right-panel">
                <form class="puppy-info-form">

                    <div class="form-row-full">
                        <div class="field-group">
                            <label for="pup-name">Puppy Name: <span class="required-accent">*</span></label>
                            <input
                                    type="text"
                                    id="pup-name"
                                    placeholder="Puppy Name..."
                                    name="pup-name"
                                    required
                            />
                        </div>
                    </div>

                    <div class="form-row-full">
                        <div class="field-group">
                            <label for="pup-bio">Bio: <span class="input-subtext">(If no bio specified, the generic one will be used)</span></label>
                            <textarea
                                    id="pup-bio"
                                    placeholder="Bio..."
                                    name="pup-bio"
                                    rows="3"
                                    maxlength="256"
                            />
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="pup-status" class="dropdown-label">Availability: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="pup-status" required>
                                    <option value="new" selected>New</option>
                                    <option value="available">Available</option>
                                    <option value="reserved">Reserved</option>
                                    <option value="sold">Sold</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="breed-select" class="dropdown-label">Breed: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="breed-select" required>
                                    <option value="">Choose Breed</option>
                                    <option value="yorkie">Yorkshire Terrier</option>
                                    <option value="biewer">Biewer Terrier</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="pup-dob">Date of Birth: <span class="required-accent">*</span></label>
                            <input
                                    type="date"
                                    id="pup-dob"
                                    value="2026-06-03"
                                    name="pup-dob"
                                    required
                            />
                        </div>

                        <div class="field-group">
                            <label for="pup-available">Available Date: <span class="required-accent">*</span></label>
                            <input
                                    type="date"
                                    id="pup-available"
                                    value="2026-06-03"
                                    name="pup-available"
                                    required
                            />
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="colour-select" class="dropdown-label">Colour: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="colour-select" required disabled>
                                    <option value="">Choose a breed first...</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="gender-select" class="dropdown-label">Gender: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="gender-select" required>
                                    <option value="">Choose Gender</option>
                                    <option value="female">Female</option>
                                    <option value="male">Male</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="mother-select" class="dropdown-label">Mother: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="mother-select" required>
                                    <option value="">Choose Mother</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="father-select" class="dropdown-label">Father: <span class="required-accent">*</span></label>
                            <div class="select-wrapper">
                                <select id="father-select" required>
                                    <option value="">Choose Father</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-row-split">
                        <div class="field-group">
                            <label for="pup-ref">Reference No: <span class="input-subtext">(Kennel Club Number)</span></label>
                            <input
                                    type="text"
                                    id="pup-ref"
                                    placeholder="Puppy Reference..."
                                    name="pup-ref"
                                    maxlength="16"
                            />
                        </div>

                        <div class="field-group id-field-group">
                            <label for="pup-id">System ID: <span class="input-subtext">(Autogenerated)</span></label>
                            <input
                                    type="text"
                                    id="pup-id"
                                    value="..."
                                    name="pup-id"
                                    disabled
                                    readonly
                            />
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="button" class="discard-btn">Discard Changes</button>
                        <button type="submit" class="submit-btn">Add Puppy</button>
                    </div>

                </form>
            </section>
        </div>

    </main>
</AdminLayout>

<style lang="scss">
    /* GLobal Layout */
    .add-puppy-view {
      max-width: 110rem;
      margin: 0 auto;
      padding: 2.5rem;
      box-sizing: border-box;
    }

    /* Header */
    .page-header {
      width: 100%;
      margin-bottom: 2.5rem;
      border-bottom: 1.5px solid var(--colour-dark);
      padding-bottom: 1rem;
    }

    .title-text {
      font-family: var(--font-primary);
      font-size: 2.6rem;
      font-weight: 800;
      color: var(--colour-dark);
      margin: 0;
    }

    /* Workspace Grid */
    .workspace-grid {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      gap: 2.5rem;
    }

    /* Photo Upload */
    .left-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 25%;
      min-width: 20rem;
    }

    .image-uploader {
      width: 100%;
      aspect-ratio: 1 / 1;
      background-color: rgba(0, 0, 0, 0.05);
      border: 2px dashed var(--colour-dark);
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      padding: 1.5rem;
      box-sizing: border-box;
      transition: background-color 0.2s ease, border-color 0.2s ease;
      margin-bottom: 1.5rem;

      &:hover {
        background-color: rgba(0, 0, 0, 0.08);
        .camera-icon {
          transform: scale(1.05);
        }
      }
    }

    .camera-icon {
      width: 3.5rem;
      height: 3.5rem;
      color: var(--colour-dark);
      margin-bottom: 0.8rem;
      transition: transform 0.2s ease
    }

    .upload-button {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--colour-white);
      text-decoration: none;
      background-color: var(--colour-dark);
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      text-align: center;
    }

    /* Required Helper */
    .required-hint {
      font-family: var(--font-primary);
      color: var(--colour-dark);
      font-weight: 700;
      font-size: 1.2rem;
    }

    /* Divider */
    .vertical-separator {
      width: 1.5px;
      background-color: rgba(0, 0, 0, 0.15);
      align-self: stretch;
      min-height: 48rem;
    }

    /* Puppy Form */
    .right-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .puppy-info-form {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 1.2rem;
    }

    /* Row Layout */
    .form-row-full {
      width: 100%;
    }

    .form-row-split {
      display: flex;
      flex-direction: row;
      width: 100%;
      gap: 1.5rem;

      .field-group {
        flex: 1;
      }

      .element-spacer {
        visibility: hidden
      }
    }

    /* Form Inputs */
    .field-group {
      display: flex;
      flex-direction: column;

      label {
        font-family: var(--font-primary);
        font-weight: 800;
        font-size: 1.3rem;
        color: var(--colour-dark);
        margin-bottom: 0.4rem;
      }

      .input-subtext {
        font-style: italic;
        font-weight: 400;
        font-size: 0.8rem;
        font-family: var(--font-secondary);
      }

      input[type="text"],
      input[type="date"],
      textarea,
      select {
        font-family: var(--font-secondary);
        background-color: rgba(0, 0, 0, 0.07);
        color: var(--colour-white);
        font-size: 1.2rem;
        padding: 0.7rem 0.9rem;
        border: 1.5px solid var(--colour-dark);
        border-radius: 0.6rem;
        outline: none;
        box-sizing: border-box;
        width: 100%;
        transition: background-color 0.2s ease, border-color 0.2s ease;

        &::placeholder {
          color: var(--colour-white);
          font-style:  italic;
        }

        &:focus {
          background-color: rgba(0, 0, 0, 0.11);
        }
      }

      textarea {
        resize: none;
      }
    }

    input:disabled,
    textarea:disabled,
    select:disabled {
      cursor: not-allowed !important;
      background-color: rgba(0, 0, 0, 0.03) !important;
      color: var(--colour-dark) !important;
      opacity: 0.5 !important;
      user-select: none;
    }

    .id-field-group {
      input[disabled] {
        font-family: var(--font-secondary);
        background-color: rgba(0, 0, 0, 0.03);
        color: var(--colour-dark);
        font-size: 1.2rem;
        padding: 0.7rem 0.9rem;
        border: 1.5px dashed var(--colour-dark);
        border-radius: 0.6rem;
        outline: none;
        box-sizing: border-box;
        width: 100%;
        transition: background-color 0.2s ease, border-color 0.2s ease;

        &::placeholder {
          color: var(--colour-white);
          font-style:  italic;
        }
      }
    }

    .required-accent {
      color: indianred;
    }

    /* Dropdowns */
    .select-wrapper {
      position: relative;
      width: 100%;

      select {
        appearance: none;
        -webkit-appearance: none;
        padding-right: 2.5rem !important;
        cursor: pointer;
      }

      &::after {
        content: "▼";
        font-size: 0.8rem;
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--colour-dark);
        pointer-events: none;
      }
    }

    /* Buttons */
    .action-buttons {
      display: flex;
      flex-direction: row;
      justify-content: flex-end;
      align-items: center;
      gap: 1.2rem;
      margin-top: 1.5rem;
      border-top: 1.5px solid rgba(0, 0, 0, 0.08);
      padding-top: 1.5rem;
      width: 100%;
    }

    .discard-btn, .submit-btn {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 700;
      padding: 0.7rem 1.6rem;
      border-radius: 0.6rem;
      cursor: pointer;
      box-sizing: border-box;
      transition: transform 0.1s ease, filter 0.2s ease;

      &:active {
        transform: scale(0.98);
      }
    }

    .discard-btn {
      background-color: transparent;
      border: 1.5px solid var(--colour-dark);
      color: var(--colour-dark);

      &:hover {
        background-color: rgba(0, 0, 0, 0.05);
      }
    }

    .submit-btn {
      background-color: var(--colour-dark);
      border: none;
      color: var(--colour-white);

      &:hover {
        filter: brightness(1.06);
      }
    }
</style>
