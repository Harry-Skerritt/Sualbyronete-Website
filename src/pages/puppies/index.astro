---
// src/pages/puppies.astro
import Layout from "../../layouts/Layout.astro";
import PawHeader from "../../components/PawHeader.astro";
import TabbedFilter from "../../components/TabbedFilter.astro";
import PuppyCard from "../../components/PuppyCard.astro";

import {Icon} from "astro-icon/components";
import { getCachedData } from "../../scripts/databaseCache";
import { SITE_NAME, PUPPY_COLOURS } from "../../config/siteSettings";

const { allPuppies } = await getCachedData();

---

<Layout title=`Puppies | ${SITE_NAME}`>
    <main>

        <PawHeader text="Available Puppies"/>

        <!-- Filters -->
        <div class="filter-parent">

            <!-- Breed Filter -->
            <div class="breed-filter">
                <TabbedFilter
                        option_one="Yorkshire Terriers"
                        option_one_icon="paw-print"
                        option_one_value="yorkies"
                        option_two="Biewer Terriers"
                        option_two_icon="paw-print"
                        option_two_value="biewers"
                        default_selected={1}
                        custom_event_name="pBreedChange"
                        class="breed-filter"
                />
            </div>



            <!-- Control Row -->
            <div class="filter-controls-row">
                <!-- Result Count (Left) -->
                <h1 class="result-count">Puppies Available: 0</h1>

                <!-- Filter Toggle (Right) -->
                <div class="filter-container" data-expanded="false">
                    <div class="filter-header">
                        <h1 class="header-text">Filters</h1>
                        <button class="filter-toggle" title="Toggle Filters" aria-label="Toggle Filters">
                            <Icon name="filter-bars" class="filter-icon"/>
                        </button>
                    </div>

                    <div class="other-filters">

                        <div class="dropdown-filter">
                            <label for="gender-select" class="dropdown-label">Gender:</label>
                            <div class="select-wrapper">
                                <select id="gender-select" data-filter-select>
                                    <option value="all" selected>All</option>
                                    <option value="female">Female</option>
                                    <option value="male">Male</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-filter">
                            <label for="colour-select" class="dropdown-label">Colour:</label>
                            <div class="select-wrapper">
                                <select id="colour-select" data-filter-select>
                                    <option value="all" selected>All</option>
                                    {PUPPY_COLOURS.map((colour) => (
                                        <option value={colour.value} data-breed-type={colour.breed}>{colour.label}</option>
                                    ))}
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-filter">
                            <label for="availability-select" class="dropdown-label">Availability:</label>
                            <div class="select-wrapper">
                                <select id="availability-select" data-filter-select>
                                    <option value="all" selected>All</option>
                                    <option value="new">New</option>
                                    <option value="available">Available</option>
                                    <option value="reserved">Reserved</option>
                                    <option value="sold">Sold</option>
                                </select>
                            </div>
                        </div>

                        <button class="reset-button">Reset Filters</button>

                    </div>
                </div>

            </div>
        </div>

        <!-- Content Grid -->
        <div id="puppy-grid" class="puppy-grid">
            {allPuppies.map((pup: any) => (
                    <div class="puppy-card-wrapper"
                         data-breed={pup.breed}
                         data-gender={pup.gender.toLowerCase()}
                         data-colour={pup.colour.toLowerCase().replace(/[^a-z]/g, '')}
                         data-status={pup.status.toLowerCase()}
                    >
                        <PuppyCard
                                puppyName={pup.name}
                                puppyGender={pup.gender}
                                puppyImage={pup.image}
                                puppyStatus={pup.status}
                                puppyBreed={pup.breed}
                                puppyColour={pup.colour}
                                puppyID={pup.id || ''}
                        />
                    </div>
            ))}

            <div id="no-results-message" class="no-results" style="display: none;">
                No puppies match your selected filter criteria.
            </div>
        </div>

    </main>
</Layout>

<style lang="scss">

    .filter-parent {
        max-width: 1750px;
        margin: 0 auto;
    }

    /* Breed Filters */
    .breed-filter {
        border: 2px solid var(--colour-dark);
        border-radius: 0.9rem;
        padding: 0.3rem;
        width: 100%;
    }

    /* Row Panel */
    .filter-controls-row {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin: 0.75rem 0 1rem 0;
    }

    /* Results */
    .result-count {
        font-family: var(--font-secondary);
        font-size: 1.4rem;
        color: var(--colour-dark);
        margin: 0;
        font-weight: 700;
    }

    /* Root Panel */
    .filter-container {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-start;
        align-items: center;
        gap: 1.5rem;
        padding: 0.5rem 1rem;
        border-radius: 1.2rem;
        background-color: var(--colour-primary);
        border: 2px solid var(--colour-dark);

        width: max-content;
        margin-left: auto;
        height: 4rem;
    }

    /* Filter Buttons */
    .filter-header{
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        gap: 0.6rem;
    }

    .header-text {
        font-family: var(--font-secondary);
        font-size: 1.1rem;
        color: var(--colour-dark);
        margin: 0;
        font-weight: 700;
    }

    /* Header Dropdown */
    .other-filters {
        display: none;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
    }

    /* Dropdowns */
    .dropdown-filter {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        align-items: center;
        justify-content: center;
        padding: 0.3rem 0.6rem;
        border-radius: 0.6rem;
    }

    .dropdown-label {
        font-family: var(--font-secondary);
        font-size: 1.1rem;
        color: var(--colour-dark);
        font-weight: 700;
    }

    select {
        width: 8rem;
        height: 1.8rem;
        border: 2px solid var(--colour-dark);
        border-radius: 0.4rem;
        background-color: var(--colour-primary);
        color: var(--colour-light);
        font-size: 0.9rem;
        font-weight: 400;
        font-family: var(--font-secondary);
        padding-left: 0.4rem;
        cursor: pointer;
    }


    /* Toggle Filters Button */
    .filter-toggle {
        border-radius: 100%;
        width: 2.2rem;
        height: 2.2rem;
        background-color: var(--colour-primary);
        border: 2px solid var(--colour-dark);
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }

    .filter-icon {
        width: 60%;
        height: 60%;
        color: var(--colour-light);
        transition: all 0.25s ease;
    }

    .filter-toggle:hover {
        background-color: var(--colour-dark);
    }

    /* Reset Button */
    .reset-button {
        display: none;
        background-color: var(--colour-dark);
        border: 2px solid transparent;
        color: var(--colour-light);
        border-radius: 0.4rem;
        padding: 0.5rem 1rem;
        transition: all 0.25s ease;
        font-family: var(--font-secondary);
        font-size: 0.9rem;
        cursor: pointer;
    }

    .reset-button:hover {
        background-color: var(--colour-primary);
        border: 2px solid var(--colour-dark);
        color: var(--colour-dark);
    }


    /* Expanded Filters */
    [data-expanded="true"] .other-filters {
        display: flex;
    }

    [data-expanded="true"] .reset-button {
        display: flex;
    }

    [data-expanded="true"] .filter-toggle {
        background-color: var(--colour-dark);
        margin-left: 1rem;
    }
    [data-expanded="true"] .filter-icon {
        transform: rotate(180deg);
    }

    /* Puppy Grid */
    .puppy-grid {
        border: 2px solid var(--colour-dark);
        padding: 2rem;
        max-width: 1750px;
        margin: 0 auto 2rem;
        border-radius: 0.6rem;

        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(20.6rem, 1fr));
        gap: 2rem;

        justify-items: center;
        justify-content: center;
    }

    :global(.no-results) {
        grid-column: 1/-1;
        padding: 2rem;
        text-align: center;
        font-weight: bold;
        font-family: var(--font-secondary);
        color: var(--colour-dark);
        font-size: 1.2rem;
    }

    /* Mobile Styling */
    @media (#{$mobile}) {
        .filter-parent,
        .puppy-grid {
            width: calc(100% - 2rem) !important;
            margin-left: 1rem !important;
            margin-right: 1rem !important;
            box-sizing: border-box;
        }

        .filter-controls-row {
            flex-direction: column-reverse;
            gap: 1rem;
            align-items: stretch;
        }

        .result-count {
            text-align: center;
            font-size: 1.2rem;
        }

        .filter-container {
            width: 100%;
            flex-direction: column;
            height: auto;
            min-height: 3.5rem;
            padding: 0.8rem;
            gap: 1rem;
            box-sizing: border-box;
        }

        .filter-header {
            width: 100%;
            justify-content: space-between;
            flex-direction: row;
            order: 1;
        }

        .filter-header .reset-button {
            position: relative;
            width: 100%;
            height: 2.8rem;
            margin-top: 0.4rem;

            order: 3;
            align-items: center;
            justify-content: center;
        }

        [data-expanded="true"] .filter-container .reset-button {
            display: flex !important;
            width: 100%;
            height: 2.8rem;
            align-items: center;
            justify-content: center;
            order: 3;
            margin-top: 0.2rem;
        }

        .other-filters {
            width: 100%;
            flex-direction: column-reverse;
            gap: 0.8rem;
            order: 2;
        }

        [data-expanded="true"] .filter-toggle {
            margin-left: 0;
        }

        .dropdown-filter {
            width: 100%;
            flex-direction: column;
            align-items: flex-start;
            padding: 0;
            gap: 0.2rem;
        }

        .dropdown-label {
            font-size: 1rem;
            padding-left: 0.2rem;
        }

        .select-wrapper {
            width: 100%;
        }

        select {
            width: 100%;
            height: 2.8rem;
            font-size: 1.05rem;
            background-color: var(--colour-white);
            color: var(--colour-dark);
        }

        .puppy-grid {
            padding: 1rem;
            gap: 1.5rem;
        }

    }

</style>


<script is:inline set:html={`
    window.PUPPY_DATA = ${JSON.stringify(allPuppies)};
    window.PUPPY_COLOURS = ${JSON.stringify(PUPPY_COLOURS)};
`} />

<script src="../../scripts/puppyFilter.ts"></script>

