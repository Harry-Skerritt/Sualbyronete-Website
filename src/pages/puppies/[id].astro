---
// src/pages/puppies/[id].astro
import Layout from "../../layouts/Layout.astro"

import { getCachedData } from "../../scripts/databaseCache";
import { calculateAge } from "../../scripts/ageCalculator";
import {
    DEFAULT_BIEWER_BIO,
    DEFAULT_YORKIE_BIO,
    PUPPY_INCLUSIONS,
    RESERVATION_COST,
    RESERVATION_LENGTH,
    SITE_NAME
} from "../../config/siteSettings";
import {getColourLabel, formatGender, getFormattedBreed} from "../../config/puppyConstants";

const { id } = Astro.params;
if (!id) {
    return Astro.redirect('/404');
}

const { allPuppies, parents, defaultBios, puppyPack } = await getCachedData();

const puppy = allPuppies.find((p: any) => p.id === id);

if (!puppy) {
    return Astro.redirect('/404');
}


// Parents
const adultMap = new Map(parents.map((adult: any) => [adult.id, adult.name]));
const motherName = adultMap.get(puppy.mother) || puppy.mother;
const fatherName = adultMap.get(puppy.father) || puppy.father;
const dynamicAge = calculateAge(puppy.dob);

// Bio
const isBioEmpty = !puppy.bio || puppy.bio.trim() === "" || puppy.bio === "No bio specified";
const normalisedBreed = puppy.breed?.toLowerCase().trim();
const dynamicBio = isBioEmpty
    ? (normalisedBreed === "yorkie" || normalisedBreed === "yorkshire terrier" ? defaultBios.yorkie : defaultBios.biewer)
    : puppy.bio;

// Puppy Pack
interface NormalItem {
    title: string;
    subItems: string[];
}

const formattedInclusions = puppyPack.reduce<NormalItem[]>((accumulator, currentItem) => {
    if (!currentItem.isSubItem) {
        accumulator.push({
            title: currentItem.value,
            subItems: []
        });
    } else {
        if (accumulator.length > 0) {
            accumulator[accumulator.length - 1].subItems.push(currentItem.value);
        } else {
            accumulator.push({
                title: currentItem.value,
                subItems: []
            });
        }
    }
    return accumulator;
}, []);
---

<Layout title={`Meet ${puppy.name} | ${SITE_NAME}`}>
    <main class="puppy-info-container">

        <!-- Left Hand Content (Image & Pricing) -->
        <div class="left-content">
            <div class="puppy-image">
                <div class="puppy-status-badge" data-status={puppy.status.toLowerCase()}>
                    <h1 class="puppy-status">{puppy.status.toUpperCase()}</h1>
                </div>

                <img
                        src={`/images/puppies/${puppy.image}`}
                        alt={`${getFormattedBreed(puppy.breed)} Puppy`}
                />
            </div>

            <div class="pricing-section">
                <span class="pricing-text">
                    For Pricing please
                    <a href={`/contact?ref=${puppy.id}&name=${puppy.name}`} class="pricing-contact">Contact Me</a>
                </span>

                <span class="deposit-text">
                    <span class="accent">*</span>
                    All puppies require a non-refundable reservation deposit of {RESERVATION_COST}.
                    This will ensure your puppy is held for {RESERVATION_LENGTH}
                </span>
            </div>
        </div>

        <!-- Right Hand Content (Puppy Info) -->
        <div class="right-content">
            <div class="puppy-main-header">
                <p class="puppy-name">{formatGender(puppy.name)}</p>
                <span class="puppy-description">
                    {dynamicBio}
                </span>
            </div>

            <div class="horizontal-separator"/>

            <div class="info-lists">
                <dl class="puppy-specs-list">
                    <dt>Breed:</dt>
                    <dd>{getFormattedBreed(puppy.breed)}</dd>

                    <dt>DoB:</dt>
                    <dd>{puppy.dob}</dd>

                    <dt>Age:</dt>
                    <dd>{dynamicAge}</dd>

                    <dt>Gender:</dt>
                    <dd>{formatGender(puppy.gender)}</dd>

                    <dt>Colour:</dt>
                    <dd>{getColourLabel(puppy.colour)}</dd>

                    <dt>Available From:</dt>
                    <dd>{puppy.availableFrom}</dd>

                    <dt>Mother:</dt>
                    <dd><a href={`/adults/${puppy.mother}`}>{motherName}</a></dd>

                    <dt>Father:</dt>
                    <dd><a href={`/adults/${puppy.father}`}>{fatherName}</a></dd>

                    <dt>Reg #:</dt>
                    <dd>#{puppy.regID}</dd>
                </dl>

                <div class="vertical-separator"/>

                <div class="included-info">
                    <h1 class="included-header">All Puppies come included with:</h1>
                    <ul class="included-list">
                        {formattedInclusions.map((item) => (
                                <li>
                                    {item.title}

                                    {item.subItems && item.subItems.length > 0 && (
                                            <ul class="puppy-pack-list">
                                                {item.subItems.map((subItem) => (
                                                        <li>{subItem}</li>
                                                ))}
                                            </ul>
                                    )}
                                </li>
                        ))}
                    </ul>
                </div>
            </div>

        </div>


    </main>
</Layout>

<style lang="scss">
  @import "../../styles/variables.scss";

  :root {
    --max-display-width: 120rem;

    @media (#{$small-desktop}) {
      --max-display-width: 94rem;
    }
  }

  .puppy-info-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    max-width: var(--max-display-width);
    margin: 0 auto;
    padding: 2rem 3rem;
    box-sizing: border-box;
    gap: 4rem;

    @media (#{$small-desktop}) {
      gap: 2.5rem;
      padding: 2rem;
    }

    @media (#{$mobile}) {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.5rem;
      gap: 2rem 0;
    }
  }

  /* Left Content */
  .left-content {
    flex: 0 0 37rem;
    display: flex;
    flex-direction: column;

    @media (#{$small-desktop}) {
      flex: 0 0 30rem;
    }

    @media (#{$mobile}) {
      width: 100%;
      flex: none;
      display: contents;
    }
  }

  /* Image */
  .puppy-image {
    width: 37rem;

    @media (#{$small-desktop}) {
      width: 30rem;
    }

    @media (#{$mobile}) {
      width: 100%;
      max-width: 45rem;
    }
  }

  .puppy-status-badge {
    width: 100%;
    height: 4rem;
    border: 0.4rem solid var(--colour-light);
    border-bottom: none;
    border-radius: 1.2rem 1.2rem 0 0;
    display: flex;
    justify-content: center;
    align-items: center;

    @media (#{$small-desktop}) {
      height: 3.5rem;
      border-width: 0.3rem;
    }
  }

  .puppy-status {
    color: var(--colour-white);
    font-family: var(--font-secondary);
    font-size: 2rem;
    text-align: center;
    margin: 0;

    @media (#{$small-desktop}) {
      font-size: 1.6rem;
    }
  }

  /* Status Styling */
  .puppy-status-badge[data-status="new"] { background-color: var(--puppy-new-colour); }
  .puppy-status-badge[data-status="available"] { background-color: var(--puppy-available-colour); }
  .puppy-status-badge[data-status="reserved"] { background-color: var(--puppy-reserved-colour); }
  .puppy-status-badge[data-status="sold"] { background-color: var(--puppy-sold-colour); }
  .puppy-status-badge[data-status="not available"] { background-color: var(--puppy-not-available-colour); }

  img {
    width: 100%;
    height: 37rem;
    object-fit: cover;
    object-position: 0 20%;
    border-radius: 0 0 0.8rem 0.8rem;
    border: 0.4rem solid var(--colour-light);
    border-top: none;
    box-sizing: border-box;

    @media (#{$small-desktop}) {
      height: 30rem;
      border-width: 0.3rem;
    }

    @media (#{$mobile}) {
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }

  /* Pricing */
  .pricing-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 1.5rem;
    gap: 0.5rem;

    @media (#{$mobile}) {
      margin-top: 1.5rem;
      padding: 1.5rem;
      background-color: rgba(0, 0, 0, 0.15);
      border-radius: 0.8rem;
      border: 2px solid var(--colour-dark);
      box-sizing: border-box;
    }
  }

  .pricing-text {
    font-size: 1.8rem;
    color: var(--colour-white);
    font-weight: bold;

    @media (#{$small-desktop}) {
      font-size: 1.4rem;
    }

    @media (#{$mobile}) {
      font-size: 1.4rem;
      text-align: center;
    }
  }

  .pricing-contact {
    color: var(--colour-dark);

    @media(#{$mobile}) {
      display: inline-block;
      background-color: var(--colour-dark);
      color: var(--colour-light);
      padding: 0.3rem 0.8rem;
      border-radius: 0.4rem;
      margin-left: 0.3rem;
      margin-top: 1rem;
    }
  }

  .deposit-text {
    font-family: var(--font-secondary);
    font-size: 1rem;
    color: var(--colour-white);
    margin: 0;

    @media (#{$small-desktop}) {
      font-size: 0.85rem;
      line-height: 1.25rem;
    }

    @media (#{$mobile}) {
      font-size: 0.95rem;
      line-height: 1.3rem;
      text-align: center;
      margin-top: 0.4rem;
    }
  }

  .accent {
    color: var(--colour-dark);
  }


  /* Right Content */
  .right-content {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin: 0;
    padding: 0;

    @media (#{$mobile}) {
      display: flex;
      flex-direction: column;
      width: 100%;
      order: 2;
    }
  }

  .puppy-main-header {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .puppy-name {
    font-family: var(--font-primary);
    font-size: 4rem;
    font-weight: bold;
    color: var(--colour-white);
    line-height: 4.4rem;
    padding: 0;
    margin: 0;
    width: 100%;

    @media (#{$small-desktop}) {
      font-size: 3.2rem;
      line-height: 3.6rem;
    }

    @media (#{$mobile}) {
      font-size: 3rem;
      line-height: 3.4rem;
    }
  }

  .puppy-description {
    display: block;
    font-family: var(--font-secondary);
    color: var(--colour-white);
    width: 90%;
    height: 5rem;
    margin-top: 0.6rem;
    font-size: 1.2rem;

    @media (#{$small-desktop}) {
      font-size: 1.05rem;
      height: auto;
      margin-bottom: 0.5rem;
    }

    @media (#{$mobile}) {
      width: 100%;
      height: auto;
      margin-bottom: 0.5rem;
    }
  }

  .horizontal-separator {
    width: 100%;
    height: 0.3rem;
    background-color: var(--colour-dark);
    border-radius: 999px;
    margin: 1rem 0;

    @media (#{$mobile}) {
      display: none;
    }
  }

  /* Info Lists */
  .info-lists {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 3rem;

    @media (#{$small-desktop}) {
      gap: 1.5rem;
    }

    @media (#{$mobile}) {
      flex-direction: column;
      gap: 2.5rem;
    }
  }

  /* Puppy Info */
  .puppy-specs-list {
    flex: 1;
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0.5rem 0px;
    margin: 1rem 0;

    @media (#{$small-desktop}) {
      grid-template-columns: 10rem 1fr;
    }

    @media (#{$mobile}) {
      width: 100%;
      grid-template-columns: 11rem 1fr;
    }
  }

  dt, dd {
    display: flex;
    align-items: center;
    height: 2.5rem;
    font-size: 1.3rem;
    box-sizing: border-box;

    @media (#{$small-desktop}) {
      font-size: 1.15rem;
      height: 2.2rem;
    }

    @media (#{$mobile}) {
      font-size: 1.18rem;
    }
  }

  dt {
    font-family: var(--font-primary);
    font-weight: 900;
    color: var(--colour-dark);
    margin: 0;
    padding-left: 0.4rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0.5rem 0 0 0.5rem;
    border-right: none;
  }

  dd {
    font-family: var(--font-secondary);
    color: var(--colour-white);
    margin: 0;
    padding-left: 0.6rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0 0.5rem 0.5rem 0;
    border-left: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a {
    color: var(--colour-white);
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    &:hover { text-decoration: underline; }
  }

  dd a {
    display: inline-block;
    background-color: var(--colour-dark);
    padding: 0.2rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 1rem;

    @media (#{$small-desktop}) {
      font-size: 0.9rem;
      padding: 0.15rem 0.6rem;
    }
  }

  .vertical-separator {
    width: 0.3rem;
    align-self: stretch;
    min-height: 25rem;
    background-color: var(--colour-dark);
    border-radius: 999px;
    margin: 0;

    @media (#{$mobile}) {
      display: none;
    }
  }

  /* Included Info */
  .included-info {
    flex: 1;
    padding-left: 1rem;

    @media (#{$small-desktop}) {
      padding-left: 0.5rem;
    }

    @media (#{$mobile}) {
      width: 100%;
      padding-left: 0;
    }
  }

  .included-header {
    color: var(--colour-dark);
    font-family: var(--font-primary);
    font-size: 1.8rem;
    font-weight: 900;
    font-weight: 900;
    margin: 0 0 1rem 0;

    @media (#{$small-desktop}) {
      font-size: 1.45rem;
    }
  }

  .included-list {
    margin: 0;
    padding-left: 1.5rem;
    li {
      color: var(--colour-light);
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      margin-bottom: 0.4rem;

      @media (#{$small-desktop}) {
        font-size: 1.05rem;
      }
    }
  }

  .puppy-pack-list {
    margin-top: 0.3rem;
    padding-left: 1.2rem;
  }

</style>
