---
// src/pages/puppies/[id].astro
import Layout from "../../layouts/Layout.astro"

import { getDB } from "../../db/index";
import { puppies, adults } from "../../db/schema";
import { calculateAge } from "../../scripts/ageCalculator";
import { eq } from "drizzle-orm";

const { id } = Astro.params;
if (!id) {
    return Astro.redirect('/404');
}

const db = getDB();

const puppyArray = await db.select().from(puppies).where(eq(puppies.id, id));
const puppy = puppyArray[0];

if (!puppy) {
    return Astro.redirect('/404');
}

const allAdults = await db.select().from(adults);
const adultMap = new Map(allAdults.map((adult: any) => [adult.id, adult.name]));

const motherName = adultMap.get(puppy.mother) || puppy.mother;
const fatherName = adultMap.get(puppy.father) || puppy.father;
const dynamicAge = calculateAge(puppy.dob);

import { getColourLabel, formatGender } from "../../config/puppyConstants";
---

<Layout title={`Meet ${puppy.name} | Sualbyronete`}>
    <main class="puppy-info-container">

        <!-- Left Hand Content (Image & Pricing) -->
        <div class="left-content">
            <div class="puppy-image">
                <div class="puppy-status-badge" data-status={puppy.status.toLowerCase()}>
                    <h1 class="puppy-status">{puppy.status.toUpperCase()}</h1>
                </div>

                <img
                        src={`/images/puppies/${puppy.image}`}
                        alt={`${puppy.breed.toLowerCase() === 'yorkie' ? 'Yorkshire Terrier' : 'Biewer Terrier'} Puppy`}
                />
            </div>

            <div class="pricing-section">
                <span class="pricing-text">
                    For Pricing please
                    <a href={`/contact?ref=${puppy.id}&name=${puppy.name}`} class="pricing-contact">Contact Me</a>
                </span>

                <span class="deposit-text">
                    <span class="accent">*</span>
                    All puppies require a non-refundable reservation deposit of £100.
                    This will ensure your puppy is held for X days
                </span>
            </div>
        </div>

        <!-- Right Hand Content (Puppy Info) -->
        <div class="right-content">
            <div class="puppy-main-header">
                <p class="puppy-name">{formatGender(puppy.name)}</p>
                <span class="puppy-description">
                    {puppy.bio}
                </span>
            </div>

            <div class="horizontal-separator"/>

            <div class="info-lists">
                <dl class="puppy-specs-list">
                    <dt>Breed:</dt>
                    <dd>{puppy.breed.toLowerCase() === 'yorkie' ? 'Yorkshire Terrier' : 'Biewer Terrier'}</dd>

                    <dt>DoB:</dt>
                    <dd>{puppy.dob}</dd>

                    <dt>Age:</dt>
                    <dd>{dynamicAge}</dd>

                    <dt>Gender:</dt>
                    <dd>{formatGender(puppy.gender)}</dd>

                    <dt>Colour:</dt>
                    <dd>{getColourLabel(puppy.colour)}</dd>

                    <dt>Available From:</dt>
                    <dd>{puppy.availableFrom}</dd>

                    <dt>Mother:</dt>
                    <dd><a href={`/adults/${puppy.mother}`}>{motherName}</a></dd>

                    <dt>Father:</dt>
                    <dd><a href={`/adults/${puppy.father}`}>{fatherName}</a></dd>

                    <dt>Reg #:</dt>
                    <dd>{puppy.regID}</dd>
                </dl>

                <div class="vertical-separator"/>

                <div class="included-info">
                    <h1 class="included-header">All Puppies come included with:</h1>
                    <ul class="included-list">
                        <li>Pedigree</li>
                        <li>Vaccinations</li>
                        <li>Health Record</li>
                        <li>Microchipped</li>
                        <li>Insured</li>
                        <li>Socialised with other dogs</li>

                        <li>
                            Puppy Pack Including:
                            <ul class="puppy-pack-list">
                                <li>Owners Contract</li>
                                <li>Feeding Instructions</li>
                                <li>History from Birth to when they join your family</li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>

        </div>


    </main>
</Layout>

<style lang="scss">

  .puppy-info-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    max-width: 120rem;
    margin: 0 auto;
    padding: 2rem 3rem;
    box-sizing: border-box;
    gap: 4rem;
  }

  /* Left Content */
  .left-content {
    flex: 0 0 37rem;
    display: flex;
    flex-direction: column;
  }

  /* Image */
  .puppy-image {
    width: 37rem;
  }

  .puppy-status-badge {
    width: 100%;
    height: 4rem;
    border: 0.4rem solid var(--colour-light);
    border-bottom: none;
    border-radius: 1.2rem 1.2rem 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .puppy-status {
    color: var(--colour-white);
    font-family: var(--font-secondary);
    font-size: 2rem;
    text-align: center;
    margin: 0;
  }

  /* Status Styling */
  .puppy-status-badge[data-status="new"] {
    background-color: var(--puppy-new-colour);
  }

  .puppy-status-badge[data-status="available"] {
    background-color: var(--puppy-available-colour);
  }

  .puppy-status-badge[data-status="reserved"] {
    background-color: var(--puppy-reserved-colour);
  }

  .puppy-status-badge[data-status="sold"] {
    background-color: var(--puppy-sold-colour);
  }

  .puppy-status-badge[data-status="not available"] {
    background-color: var(--puppy-not-available-colour);
  }

  img {
    width: 100%;
    height: 37rem;
    object-fit: cover;
    object-position: 0 20%;
    border-radius: 0 0 0.8rem 0.8rem;
    border: 0.4rem solid var(--colour-light);
    border-top: none;
    box-sizing: border-box;
  }

  /* Pricing */
  .pricing-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 1.5rem;
    gap: 0.5rem
  }

  .pricing-text {
    font-size: 1.8rem;
    color: var(--colour-white);
    font-weight: bold;
  }

  .pricing-contact {
    color: var(--colour-dark);
  }

  .deposit-text {
    font-family: var(--font-secondary);
    font-size: 1rem;
    color: var(--colour-white);
    margin: 0;
  }

  .accent {
    color: var(--colour-dark);
  }


  /* Right Content */
  .right-content {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin: 0;
    padding: 0;
  }

  .puppy-main-header {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .puppy-name {
    font-family: var(--font-primary);
    font-size: 4rem;
    font-weight: bold;
    color: var(--colour-white);
    line-height: 4.4rem;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .puppy-description {
    display: block;
    font-family: var(--font-secondary);
    color: var(--colour-white);
    width: 90%;
    height: 5rem;
    margin-top: 0.6rem;
    font-size: 1.2rem;
  }

  .horizontal-separator {
    width: 100%;
    height: 0.3rem;
    background-color: var(--colour-dark);
    border-radius: 999px;
    margin: 1rem 0;
  }

  /* Info Lists */
  .info-lists {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 3rem;
  }

  /* Puppy Info */
  .puppy-specs-list {
    flex: 1;
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0.5rem 0px;
    margin: 1rem 0;
  }

  dt, dd {
    display: flex;
    align-items: center;
    height: 2.5rem;
    font-size: 1.3rem;
    box-sizing: border-box;
  }

  dt {
    font-family: var(--font-primary);
    font-weight: 900;
    color: var(--colour-dark);
    margin: 0;
    padding-left: 0.4rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0.5rem 0 0 0.5rem;
    border-right: none;
  }

  dd {
    font-family: var(--font-secondary);
    color: var(--colour-white);
    margin: 0;
    padding-left: 0.6rem;
    border: 2px solid var(--colour-dark);
    border-radius: 0 0.5rem 0.5rem 0;
    border-left: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a {
    color: var(--colour-white);
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    &:hover { text-decoration: underline; }
  }

  dd a {
    display: inline-block;
    background-color: var(--colour-dark);
    padding: 0.2rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 1rem;
  }

  .vertical-separator {
    width: 0.3rem;
    align-self: stretch;
    min-height: 25rem;
    background-color: var(--colour-dark);
    border-radius: 999px;
    margin: 0;
  }

  /* Included Info */
  .included-info {
    flex: 1;
    padding-left: 1rem;
  }

  .included-header {
    color: var(--colour-dark);
    font-family: var(--font-primary);
    font-size: 1.8rem;
    font-weight: 900;
    margin: 0 0 1rem 0;
  }

  .included-list {
    margin: 0;
    padding-left: 1.5rem;
    li {
      color: var(--colour-light);
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      margin-bottom: 0.4rem;
    }
  }

  .puppy-pack-list {
    margin-top: 0.3rem;
    padding-left: 1.2rem;
  }

  /* Mobile Styling */
  @media ($mobile) {
    .puppy-info-container {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1.5rem;
      gap: 2rem 0;
    }

    /* Left (Top) Content */
    .left-content {
      width: 100%;
      flex: none;
      display: contents;
    }

    .puppy-image {
      width: 100%;
      max-width: 45rem;
    }

    img {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .puppy-name {
      font-size: 3rem;
      line-height: 3.4rem;
    }

    .puppy-description {
      width: 100%;
      height: auto;
      margin-bottom: 0.5rem;
    }

    /* Pricing */
    .pricing-section {
      margin-top: 1.5rem;
      padding: 1.5rem;
      background-color: rgba(0, 0, 0, 0.15);
      border-radius: 0.8rem;
      border: 2px solid var(--colour-dark);
      box-sizing: border-box;
    }

    .pricing-text {
      font-size: 1.4rem;
      text-align: center;
    }

    .pricing-contact {
      display: inline-block;
      background-color: var(--colour-dark);
      color: var(--colour-light);
      padding: 0.3rem 0.8rem;
      border-radius: 0.4rem;
      margin-left: 0.3rem;
      margin-top: 1rem;
    }

    .deposit-text {
      font-size: 0.95rem;
      line-height: 1.3rem;
      text-align: center;
      margin-top: 0.4rem;
    }

    /* Right (Bottom) Content */
    .right-content {
      display: flex;
      flex-direction: column;
      width: 100%;
      order: 2;
    }

    .info-lists {
      flex-direction: column;
      gap: 2.5rem;
    }

    dd, dt {
      font-size: 1.18rem;
    }

    .vertical-separator, .horizontal-separator {
      display: none;
    }

    .puppy-specs-list {
      width: 100%;
      grid-template-columns: 11rem 1fr;
    }

    .included-info {
      width: 100%;
      padding-left: 0;
    }
  }

</style>
