{
	"name": "sualbyronete-puppies",
	"compatibility_date": "2026-06-04",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "puppies_db",
			"database_id": "local-dev-id",
			"migrations_dir": "./drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "SUALBYRONETE_MEDIA",
			"bucket_name": "sualbyronete-media",
			"preview_bucket_name": "sualbyronete-media-local",

			"allowed_origins": [
				"http://localhost:4321",
				"http://admin.localhost:4321"
			]
		}
	]
}